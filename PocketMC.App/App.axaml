<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PocketMC.App"
             x:Class="PocketMC.App.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://PocketMC.App/Styles/ControlStyles.axaml"/>
        <StyleInclude Source="avares://PocketMC.App/Styles/SkeletonStyles.axaml"/>

        <!-- High-Contrast Accessible Style for AI Action Buttons & Crash Dialogs -->
        <Style Selector="Button.ai-action">
            <Setter Property="Background" Value="#0066D6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2A85FF" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ai-action:pointerover">
            <Setter Property="Background" Value="#1A7BE6" />
            <Setter Property="BorderBrush" Value="#4EA0FF" />
        </Style>
        <Style Selector="Button.ai-action:pressed">
            <Setter Property="Background" Value="#0052B3" />
            <Setter Property="BorderBrush" Value="#00408C" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/icon.png" ToolTipText="PocketMC Desktop" Clicked="TrayIcon_Clicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open PocketMC" Click="TrayOpen_Clicked"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Quit PocketMC" Click="TrayQuit_Clicked"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Root dynamic accent fallbacks updated at runtime by AccentColorService -->
            <SolidColorBrush x:Key="AccentBrush" Color="#008B00"/>
            <SolidColorBrush x:Key="AccentColorBrush" Color="#008B00"/>
            <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#008B00"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#008B00"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#199B19"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#007300"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#4ECC4E"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF"/>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Standard Avalonia Tokens (WPF-UI Light translucent layering) -->
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EEF3F5F8"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4000000"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E000000"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#72000000"/>
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="ControlFillSecondaryBrush" Color="#80F9F9F9"/>
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#18000000"/>
                    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#121214"/>
                    <SolidColorBrush x:Key="ConsoleHeaderBackgroundBrush" Color="#E6EAEFF5"/>
                    <SolidColorBrush x:Key="ConsoleTextBrush" Color="#F4F4F7"/>
                    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#008B00"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#008B00"/>
                    <SolidColorBrush x:Key="AccentColorBrush" Color="#008B00"/>

                    <!-- Windows WPF UI Parity Tokens (Light) -->
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#80F6F6F6"/>
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#80F9F9F9"/>
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#18000000"/>
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000"/>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000"/>
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000"/>
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C000000"/>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#008B00"/>
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#007300"/>
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#005E00"/>
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#006600"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C42B1C"/>
                    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#9D5D00"/>
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#0F7B0F"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <!-- Standard Avalonia Tokens (WPF-UI Dark frosted translucency over blurred wallpaper) -->
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E61E1E20"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0FFFFFFF"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#17FFFFFF"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8FFFFFF"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#8AFFFFFF"/>
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#12FFFFFF"/>
                    <SolidColorBrush x:Key="ControlFillSecondaryBrush" Color="#19FFFFFF"/>
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#1DFFFFFF"/>
                    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#CC0B0B0D"/>
                    <SolidColorBrush x:Key="ConsoleHeaderBackgroundBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="ConsoleTextBrush" Color="#F4F4F7"/>
                    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#008B00"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#008B00"/>
                    <SolidColorBrush x:Key="AccentColorBrush" Color="#008B00"/>

                    <!-- Windows WPF UI Parity Tokens (Dark) -->
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0FFFFFFF"/>
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#17FFFFFF"/>
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1EFFFFFF"/>
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#1DFFFFFF"/>
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B8FFFFFF"/>
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8AFFFFFF"/>
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF"/>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#008B00"/>
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#199B19"/>
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#007300"/>
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#4ECC4E"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF"/>
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF99A4"/>
                    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FCE100"/>
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#6CCB5F"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
