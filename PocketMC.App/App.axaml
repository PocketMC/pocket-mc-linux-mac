<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PocketMC.App"
             x:Class="PocketMC.App.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://PocketMC.App/Styles/SkeletonStyles.axaml"/>

        <!-- High-Contrast Accessible Style for AI Action Buttons & Crash Dialogs -->
        <Style Selector="Button.ai-action">
            <Setter Property="Background" Value="#0066D6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2A85FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ai-action:pointerover">
            <Setter Property="Background" Value="#1A7BE6" />
            <Setter Property="BorderBrush" Value="#4EA0FF" />
        </Style>
        <Style Selector="Button.ai-action:pressed">
            <Setter Property="Background" Value="#0052B3" />
            <Setter Property="BorderBrush" Value="#00408C" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/icon.png" ToolTipText="PocketMC Desktop" Clicked="TrayIcon_Clicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open PocketMC" Click="TrayOpen_Clicked"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Quit PocketMC" Click="TrayQuit_Clicked"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Standard Avalonia Tokens -->
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F4F7"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18181B"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#71717A"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#A1A1AA"/>
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F4F4F7"/>
                    <SolidColorBrush x:Key="ControlFillSecondaryBrush" Color="#F4F4F7"/>
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#1E1E24"/>
                    <SolidColorBrush x:Key="ConsoleHeaderBackgroundBrush" Color="#F4F4F7"/>
                    <SolidColorBrush x:Key="ConsoleTextBrush" Color="#18181B"/>
                    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#0066D6"/>

                    <!-- Windows WPF UI Parity Tokens -->
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F9F9F9"/>
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#F4F4F7"/>
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#EBEBEF"/>
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#18181B"/>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#71717A"/>
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A1A1AA"/>
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#D4D4D8"/>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0066D6"/>
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0052B3"/>
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C42B1C"/>
                    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#D97706"/>
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#059669"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- Standard Avalonia Tokens -->
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#121214"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E1E24"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#2D2D30"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F7"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A"/>
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2A2A30"/>
                    <SolidColorBrush x:Key="ControlFillSecondaryBrush" Color="#252528"/>
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3F3F46"/>
                    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#0C0C0D"/>
                    <SolidColorBrush x:Key="ConsoleHeaderBackgroundBrush" Color="#1E1E24"/>
                    <SolidColorBrush x:Key="ConsoleTextBrush" Color="#F4F4F7"/>
                    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#0066D6"/>

                    <!-- Windows WPF UI Parity Tokens -->
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1E1E24"/>
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#252528"/>
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2D2D30"/>
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#252528"/>
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#2A2A30"/>
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#3F3F46"/>
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F4F4F7"/>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A1A1AA"/>
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#71717A"/>
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#52525B"/>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0066D6"/>
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#4EA0FF"/>
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF4444"/>
                    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#F59E0B"/>
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#10B981"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
