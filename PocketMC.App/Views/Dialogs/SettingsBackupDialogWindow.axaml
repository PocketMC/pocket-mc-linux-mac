<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="using:Lucide.Avalonia"
        xmlns:dialogs="using:PocketMC.App.Views.Dialogs"
        x:Class="PocketMC.App.Views.Dialogs.SettingsBackupDialogWindow"
        Title="Settings Backup &amp; Restore"
        Width="540" Height="640"
        MinWidth="460" MaxWidth="640"
        MinHeight="450" MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource CardBackgroundBrush}">

  <Grid Margin="24,20,24,20" RowDefinitions="Auto, Auto, *, Auto">
    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto, 14, *" Margin="0,0,0,16">
      <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
              Background="#263498DB" HorizontalAlignment="Center" VerticalAlignment="Center">
        <lucide:LucideIcon x:Name="HeaderIcon" Kind="Download" Size="22" Foreground="#3498DB"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>

      <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
        <TextBlock x:Name="TxtTitle" Text="Backup Settings" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock x:Name="TxtSubtitle"
                   Text="Select configuration categories and credentials to export."
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>

    <!-- Toolbar: Select/Deselect All -->
    <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
      <TextBlock Text="Categories &amp; Data:" FontSize="13" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Select All" Click="SelectAll_Click"
                Background="{DynamicResource InputBackgroundBrush}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Padding="10,4" FontSize="11" CornerRadius="4" Cursor="Hand"/>
        <Button Content="Deselect All" Click="DeselectAll_Click"
                Background="{DynamicResource InputBackgroundBrush}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Padding="10,4" FontSize="11" CornerRadius="4" Cursor="Hand"/>
      </StackPanel>
    </Grid>

    <!-- Categories List -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
      <ItemsControl x:Name="CategoriesList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="dialogs:SettingsCategoryItem">
            <Border Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,8"
                    Padding="12,10">
              <Grid ColumnDefinitions="Auto, 12, *, Auto">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          VerticalAlignment="Center"/>

                <lucide:LucideIcon Grid.Column="1" Kind="{Binding IconKind}" Size="18"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border IsVisible="{Binding IsSensitive}"
                            Background="#33F39C12"
                            BorderBrush="#88F39C12"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="5,1">
                      <TextBlock Text="Credentials" FontSize="10" FontWeight="SemiBold" Foreground="#F39C12"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Action buttons -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Cancel" Click="BtnCancel_Click"
              Background="{DynamicResource InputBackgroundBrush}"
              Foreground="{DynamicResource TextSecondaryBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="1"
              Padding="18,8" CornerRadius="6" Cursor="Hand"/>

      <Button x:Name="BtnAction"
              Content="Export Backup..."
              Click="BtnAction_Click"
              Background="{DynamicResource AccentBrush}"
              Foreground="White"
              FontWeight="SemiBold"
              Padding="20,8" CornerRadius="6" Cursor="Hand"/>
    </StackPanel>
  </Grid>
</Window>
