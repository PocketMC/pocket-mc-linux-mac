<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="using:Lucide.Avalonia"
        x:Class="PocketMC.App.Views.Dialogs.AppDialogWindow"
        Title="PocketMC"
        Width="460"
        SizeToContent="Height"
        MinWidth="380" MaxWidth="540"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource CardBackgroundBrush}">

  <Grid Margin="24,20,24,20" RowDefinitions="Auto, *, Auto">
    <!-- Header: Icon + Title -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto, 14, *" Margin="0,0,0,16">
      <Border x:Name="IconBadge" Grid.Column="0" Width="42" Height="42" CornerRadius="21"
              Background="#263498DB" HorizontalAlignment="Center" VerticalAlignment="Center">
        <lucide:LucideIcon x:Name="DialogIcon" Kind="Info" Size="22" Foreground="#3498DB"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>

      <TextBlock x:Name="TxtTitle" Grid.Column="2"
                 Text="Message"
                 FontSize="17" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"/>
    </Grid>

    <!-- Message body -->
    <ScrollViewer Grid.Row="1" MaxHeight="260" Margin="0,0,0,18" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <TextBlock x:Name="TxtMessage"
                   Text="Dialog message body text goes here."
                   FontSize="13" LineHeight="20"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"/>

        <Button x:Name="BtnLink" IsVisible="False"
                Classes="hyperlink"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Cursor="Hand"
                Click="BtnLink_Click">
          <TextBlock x:Name="TxtLink" Text="More details" Foreground="#3498DB" TextDecorations="Underline" FontSize="13"/>
        </Button>
      </StackPanel>
    </ScrollViewer>

    <!-- Action buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="BtnTertiary"
              Content="Cancel"
              IsVisible="False"
              Click="BtnTertiary_Click"
              Background="{DynamicResource InputBackgroundBrush}"
              Foreground="{DynamicResource TextSecondaryBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="1"
              Padding="16,8"
              CornerRadius="6"
              Cursor="Hand"/>

      <Button x:Name="BtnSecondary"
              Content="No"
              IsVisible="False"
              Click="BtnSecondary_Click"
              Background="{DynamicResource InputBackgroundBrush}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="1"
              Padding="16,8"
              CornerRadius="6"
              Cursor="Hand"/>

      <Button x:Name="BtnPrimary"
              Content="OK"
              Click="BtnPrimary_Click"
              Background="{DynamicResource AccentBrush}"
              Foreground="White"
              FontWeight="SemiBold"
              Padding="20,8"
              CornerRadius="6"
              Cursor="Hand"/>
    </StackPanel>
  </Grid>
</Window>
