<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="using:Lucide.Avalonia"
        x:Class="PocketMC.App.Views.Dialogs.PasswordPromptDialogWindow"
        Title="Authentication"
        Width="460"
        SizeToContent="Height"
        MinWidth="380" MaxWidth="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource CardBackgroundBrush}">

  <Grid Margin="24,20,24,20" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
    <!-- Header: icon + title -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto, 14, *" Margin="0,0,0,16">
      <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
              Background="#263498DB" HorizontalAlignment="Center" VerticalAlignment="Center">
        <lucide:LucideIcon Kind="ShieldCheck" Size="22" Foreground="#3498DB"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>

      <TextBlock x:Name="TxtTitle" Grid.Column="2"
                 Text="Setup Admin Account"
                 FontSize="17" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"/>
    </Grid>

    <!-- Message body -->
    <TextBlock Grid.Row="1" x:Name="TxtMessage"
               Text="Enter administrator credentials."
               Foreground="{DynamicResource TextSecondaryBrush}"
               FontSize="13" TextWrapping="Wrap" LineHeight="20"
               Margin="0,0,0,16"/>

    <!-- Username input -->
    <TextBox Grid.Row="2" x:Name="TxtUsernameInput"
             Watermark="Enter admin username"
             Margin="0,0,0,12"
             Background="{DynamicResource InputBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             BorderBrush="{DynamicResource CardBorderBrush}"
             CornerRadius="6"
             Padding="10,8"/>

    <!-- Password input -->
    <TextBox Grid.Row="3" x:Name="PwdInput"
             PasswordChar="*"
             Watermark="Enter admin password"
             Margin="0,0,0,18"
             Background="{DynamicResource InputBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             BorderBrush="{DynamicResource CardBorderBrush}"
             CornerRadius="6"
             Padding="10,8"/>

    <!-- Action buttons -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="BtnCancel"
              Content="Cancel"
              Click="BtnCancel_Click"
              Background="{DynamicResource InputBackgroundBrush}"
              Foreground="{DynamicResource TextSecondaryBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="1"
              Padding="16,8"
              CornerRadius="6"
              Cursor="Hand"/>

      <Button x:Name="BtnPrimary"
              Content="Save Admin Account"
              Click="BtnPrimary_Click"
              Background="{DynamicResource AccentBrush}"
              Foreground="White"
              FontWeight="SemiBold"
              Padding="20,8"
              CornerRadius="6"
              Cursor="Hand"/>
    </StackPanel>
  </Grid>
</Window>
