<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PocketMC.App.ViewModels"
             xmlns:lucide="using:Lucide.Avalonia"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="680"
             x:Class="PocketMC.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <UserControl.Styles>
    <Style Selector="Border.instance-card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Focusable" Value="True"/>
    </Style>
    <Style Selector="Border.instance-card:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
    </Style>
    <Style Selector="Border.instance-card.running-border">
      <Setter Property="BorderBrush" Value="#8010B981"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style Selector="Border.status-pulse">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.35"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1.0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto, *">
    <!-- Top Header -->
    <Grid Grid.Row="0" Margin="28,20,28,12" ColumnDefinitions="Auto, Auto, *, Auto">
      <TextBlock Grid.Column="0" Text="Instances" FontSize="24" FontWeight="Bold"
                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <Button Grid.Column="1" Command="{Binding NewInstanceCommand}"
              Classes="primary" Padding="14,7" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <lucide:LucideIcon Kind="Plus" Size="16"/>
          <TextBlock Text="New Instance"/>
        </StackPanel>
      </Button>

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Command="{Binding NavigateToImportCommand}"
                Classes="secondary" Padding="12,7">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="ArchiveRestore" Size="14"/>
            <TextBlock Text="Import"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding RefreshInstancesCommand}"
                Classes="secondary" Padding="12,7" ToolTip.Tip="Refresh Instances">
          <lucide:LucideIcon Kind="RefreshCw" Size="14"/>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Main Scroll Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,0,28,28" Spacing="16">

        <!-- Loading Skeleton Cards (matches Windows 4 skeleton placeholders) -->
        <WrapPanel IsVisible="{Binding IsLoading}">
          <Border Classes="skeleton-card" Width="320" Margin="0,0,16,16">
            <StackPanel Spacing="12">
              <Border Classes="skeleton-element" Height="20" Width="170" HorizontalAlignment="Left"/>
              <Border Classes="skeleton-element" Height="16" Width="120" HorizontalAlignment="Left"/>
              <Border Classes="skeleton-element" Height="36" CornerRadius="6"/>
              <Border Classes="skeleton-element" Height="42" CornerRadius="6"/>
              <Grid ColumnDefinitions="*, 8, *">
                <Border Grid.Column="0" Classes="skeleton-element" Height="34" CornerRadius="6"/>
                <Border Grid.Column="2" Classes="skeleton-element" Height="34" CornerRadius="6"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="skeleton-card" Width="320" Margin="0,0,16,16">
            <StackPanel Spacing="12">
              <Border Classes="skeleton-element" Height="20" Width="150" HorizontalAlignment="Left"/>
              <Border Classes="skeleton-element" Height="16" Width="110" HorizontalAlignment="Left"/>
              <Border Classes="skeleton-element" Height="36" CornerRadius="6"/>
              <Border Classes="skeleton-element" Height="42" CornerRadius="6"/>
              <Grid ColumnDefinitions="*, 8, *">
                <Border Grid.Column="0" Classes="skeleton-element" Height="34" CornerRadius="6"/>
                <Border Grid.Column="2" Classes="skeleton-element" Height="34" CornerRadius="6"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="skeleton-card" Width="320" Margin="0,0,16,16">
            <StackPanel Spacing="12">
              <Border Classes="skeleton-element" Height="20" Width="180" HorizontalAlignment="Left"/>
              <Border Classes="skeleton-element" Height="16" Width="105" HorizontalAlignment="Left"/>
              <Border Classes="skeleton-element" Height="36" CornerRadius="6"/>
              <Border Classes="skeleton-element" Height="42" CornerRadius="6"/>
              <Grid ColumnDefinitions="*, 8, *">
                <Border Grid.Column="0" Classes="skeleton-element" Height="34" CornerRadius="6"/>
                <Border Grid.Column="2" Classes="skeleton-element" Height="34" CornerRadius="6"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="skeleton-card" Width="320" Margin="0,0,16,16">
            <StackPanel Spacing="12">
              <Border Classes="skeleton-element" Height="20" Width="160" HorizontalAlignment="Left"/>
              <Border Classes="skeleton-element" Height="16" Width="115" HorizontalAlignment="Left"/>
              <Border Classes="skeleton-element" Height="36" CornerRadius="6"/>
              <Border Classes="skeleton-element" Height="42" CornerRadius="6"/>
              <Grid ColumnDefinitions="*, 8, *">
                <Border Grid.Column="0" Classes="skeleton-element" Height="34" CornerRadius="6"/>
                <Border Grid.Column="2" Classes="skeleton-element" Height="34" CornerRadius="6"/>
              </Grid>
            </StackPanel>
          </Border>
        </WrapPanel>

        <!-- Empty State -->
        <Border Classes="card" Padding="48,56" IsVisible="{Binding !HasInstances}">
          <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="420">
            <lucide:LucideIcon Kind="ServerOff" Size="42" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="No server instances yet" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Create your first Minecraft server in seconds, or import an existing archive."
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
              <Button Command="{Binding NewInstanceCommand}" Classes="primary" Padding="18,9">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <lucide:LucideIcon Kind="Plus" Size="16"/>
                  <TextBlock Text="Create Server"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding NavigateToImportCommand}" Classes="secondary" Padding="14,9">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <lucide:LucideIcon Kind="ArchiveRestore" Size="15"/>
                  <TextBlock Text="Import"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Responsive Instances Grid -->
        <ItemsControl ItemsSource="{Binding Instances}" IsVisible="{Binding HasInstances}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InstanceCardViewModel">
              <Border Classes="instance-card"
                      Classes.running-border="{Binding ShowRunningBorder}"
                      Width="320" Margin="0,0,16,16"
                      KeyDown="InstanceCard_OnKeyDown">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto">

                  <!-- 1. Card Header -->
                  <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                    <StackPanel Grid.Column="0" Spacing="5">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                   MaxWidth="220"/>
                        <lucide:LucideIcon Kind="Pin" Size="13" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           IsVisible="{Binding IsPinned}" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding PinButtonTooltip}"/>
                      </StackPanel>

                      <!-- Software / Capabilities Badges -->
                      <WrapPanel Orientation="Horizontal">
                        <Border Classes="badge-pill" Margin="0,0,4,4">
                          <TextBlock Text="{Binding MinecraftVersion}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        <Border Classes="badge-pill" Margin="0,0,4,4">
                          <TextBlock Text="{Binding ServerType}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <Border Background="#1E10B981" BorderBrush="#4010B981" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                Margin="0,0,4,4"
                                IsVisible="{Binding ShowCrossPlayBadge}" ToolTip.Tip="{Binding CrossPlayBadgeTooltip}">
                          <TextBlock Text="{Binding CrossPlayBadgeText}" FontSize="11" Foreground="#34D399" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#1E3B82F6" BorderBrush="#403B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                Margin="0,0,4,4"
                                IsVisible="{Binding ShowVoiceChatBadge}" ToolTip.Tip="{Binding VoiceChatBadgeTooltip}">
                          <TextBlock Text="{Binding VoiceChatBadgeText}" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#1EA855F7" BorderBrush="#40A855F7" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                Margin="0,0,4,4"
                                IsVisible="{Binding IsImportedFromModpack}" ToolTip.Tip="{Binding ModpackBadgeTooltip}">
                          <TextBlock Text="{Binding ModpackBadgeText}" FontSize="11" Foreground="#C084FC" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#2AEF4444" BorderBrush="#60EF4444" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                Margin="0,0,4,4"
                                IsVisible="{Binding HasPortIssue}" ToolTip.Tip="{Binding PortIssueTooltip}">
                          <TextBlock Text="{Binding PortIssueBadgeText}" FontSize="11" Foreground="#F87171" FontWeight="SemiBold"/>
                        </Border>
                      </WrapPanel>

                      <!-- Status Indicator Row -->
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Classes="status-pulse" Width="8" Height="8" CornerRadius="4"
                                Background="{Binding StatusBrush}" VerticalAlignment="Center"
                                IsVisible="{Binding IsBusy}"/>
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center"
                                 IsVisible="{Binding !IsBusy}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RestartCountdownText}" FontSize="11"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   IsVisible="{Binding IsRestartCountdownActive}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- Overflow Menu Button -->
                    <Button Grid.Column="1" Classes="subtle" Padding="6" VerticalAlignment="Top"
                            ToolTip.Tip="Instance Options">
                      <lucide:LucideIcon Kind="EllipsisVertical" Size="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="{Binding PinMenuHeader}"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).TogglePinCommand}"
                                    CommandParameter="{Binding}"/>
                          <MenuItem Header="Open Console"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenConsoleCommand}"
                                    CommandParameter="{Binding}"/>
                          <MenuItem Header="Manage Players"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenPlayersCommand}"
                                    CommandParameter="{Binding}"/>
                          <MenuItem Header="Export Instance"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).ExportInstanceCommand}"
                                    CommandParameter="{Binding}"/>
                          <MenuItem Header="Copy Crash Report"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).CopyCrashReportCommand}"
                                    CommandParameter="{Binding}"/>
                          <MenuItem Header="Open Folder"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenFolderCommand}"
                                    CommandParameter="{Binding}"/>
                          <Separator/>
                          <MenuItem Header="Delete Instance" Foreground="#F87171"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).DeleteInstanceCommand}"
                                    CommandParameter="{Binding}"/>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>

                  <!-- 2. Summary Info Row -->
                  <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                          Padding="0,10,0,10" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*, *, *">
                      <StackPanel Grid.Column="0" HorizontalAlignment="Left" ToolTip.Tip="{Binding LastPlayedTooltip}">
                        <TextBlock Text="{Binding LastPlayedLabelText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding LastPlayedValueText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Created" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CreatedValueText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="Platform" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding PlatformSummaryText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- 3. Telemetry Bar -->
                  <Border Grid.Row="2" Classes="card-secondary" Padding="12,8" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*, *, *">
                      <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CpuText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="RAM" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding RamText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="PLAYERS" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PlayerStatus}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- 4. Running Connection Strings (Hostname, Numeric IP, LAN, Bedrock/Geyser, Voice Chat) -->
                  <StackPanel Grid.Row="3" Spacing="4" Margin="0,0,0,14" IsVisible="{Binding IsRunning}">
                    <!-- Primary Playit Tunnel Address or Shimmer Skeleton -->
                    <Grid ColumnDefinitions="Auto, *, Auto" IsVisible="{Binding HasTunnelAddress}">
                      <TextBlock Grid.Column="0" Text="IP:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding TunnelAddress}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Button Grid.Column="2" Classes="subtle" Padding="5,3" ToolTip.Tip="Copy IP"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).CopyIpCommand}"
                              CommandParameter="{Binding}">
                        <lucide:LucideIcon Kind="Copy" Size="12"/>
                      </Button>
                    </Grid>
                    <Grid ColumnDefinitions="Auto, *" IsVisible="{Binding ShowPrimaryTunnelSkeleton}">
                      <TextBlock Grid.Column="0" Text="IP:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <Border Grid.Column="1" Classes="skeleton-element" Height="16" CornerRadius="4"/>
                    </Grid>

                    <!-- Numeric Tunnel Address -->
                    <Grid ColumnDefinitions="Auto, *, Auto" IsVisible="{Binding HasNumericTunnelAddress}">
                      <TextBlock Grid.Column="0" Text="Num:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding NumericTunnelAddress}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Button Grid.Column="2" Classes="subtle" Padding="5,3" ToolTip.Tip="Copy Numeric IP"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).CopyNumericIpCommand}"
                              CommandParameter="{Binding}">
                        <lucide:LucideIcon Kind="Copy" Size="12"/>
                      </Button>
                    </Grid>

                    <!-- LAN IP Address -->
                    <Grid ColumnDefinitions="Auto, *, Auto" IsVisible="{Binding HasLanAddress}">
                      <TextBlock Grid.Column="0" Text="LAN:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding LanAddressDisplayText}" FontSize="11" FontFamily="Monospace"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Button Grid.Column="2" Classes="subtle" Padding="5,3" ToolTip.Tip="Copy LAN IP"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).CopyLanIpCommand}"
                              CommandParameter="{Binding}">
                        <lucide:LucideIcon Kind="Copy" Size="12"/>
                      </Button>
                    </Grid>

                    <!-- Bedrock / Geyser IP Address -->
                    <Grid ColumnDefinitions="Auto, *, Auto" IsVisible="{Binding ShowBedrockIp}">
                      <TextBlock Grid.Column="0" Text="{Binding BedrockIpLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding BedrockIpDisplayText}" FontSize="11" Foreground="#34D399"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Button Grid.Column="2" Classes="subtle" Padding="5,3" ToolTip.Tip="Copy Bedrock IP"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).CopyBedrockIpCommand}"
                              CommandParameter="{Binding}">
                        <lucide:LucideIcon Kind="Copy" Size="12"/>
                      </Button>
                    </Grid>

                    <!-- Voice Chat Tunnel -->
                    <Grid ColumnDefinitions="Auto, *, Auto" IsVisible="{Binding ShowVoiceChatRow}">
                      <TextBlock Grid.Column="0" Text="Voice:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding VoiceChatTunnelAddress, FallbackValue='Local UDP configured'}" FontSize="11"
                                 Foreground="#60A5FA" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Button Grid.Column="2" Classes="subtle" Padding="5,3" IsVisible="{Binding HasVoiceChatTunnelAddress}" ToolTip.Tip="Copy Voice Chat Address"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).CopyVoiceChatIpCommand}"
                              CommandParameter="{Binding}">
                        <lucide:LucideIcon Kind="Copy" Size="12"/>
                      </Button>
                    </Grid>
                  </StackPanel>

                  <!-- 5. Action Buttons -->
                  <Grid Grid.Row="4" RowDefinitions="Auto, 6, Auto">
                    <!-- Stopped Controls -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, 6, *" IsVisible="{Binding ShowStoppedControls}">
                      <Button Grid.Column="0"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).StartServerCommand}"
                              CommandParameter="{Binding}"
                              Classes="primary"
                              HorizontalAlignment="Stretch" Padding="0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                          <lucide:LucideIcon Kind="Play" Size="14"/>
                          <TextBlock Text="Start"/>
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="2"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenConsoleCommand}"
                              CommandParameter="{Binding}"
                              Classes="secondary"
                              HorizontalAlignment="Stretch" Padding="0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                          <lucide:LucideIcon Kind="Terminal" Size="14"/>
                          <TextBlock Text="Logs"/>
                        </StackPanel>
                      </Button>
                    </Grid>

                    <!-- Running Controls -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, 6, *" IsVisible="{Binding ShowRunningControls}">
                      <Button Grid.Column="0"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).StopServerCommand}"
                              CommandParameter="{Binding}"
                              Classes="danger"
                              HorizontalAlignment="Stretch" Padding="0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                          <lucide:LucideIcon Kind="Square" Size="13"/>
                          <TextBlock Text="{Binding StopButtonText}"/>
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="2"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).RestartServerCommand}"
                              CommandParameter="{Binding}"
                              Classes="secondary"
                              HorizontalAlignment="Stretch" Padding="0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                          <lucide:LucideIcon Kind="RotateCw" Size="14"/>
                          <TextBlock Text="Restart"/>
                        </StackPanel>
                      </Button>
                    </Grid>

                    <!-- Bottom Row: Logs/Players + Files + Settings -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, 6, *, 6, *" IsVisible="{Binding ShowRunningControls}">
                      <Button Grid.Column="0"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenConsoleCommand}"
                              CommandParameter="{Binding}"
                              Classes="secondary" HorizontalAlignment="Stretch" Padding="0,7" ToolTip.Tip="Console Logs">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                          <lucide:LucideIcon Kind="Terminal" Size="13"/>
                          <TextBlock Text="Logs" FontSize="12"/>
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="2"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenPlayersCommand}"
                              CommandParameter="{Binding}"
                              Classes="secondary" HorizontalAlignment="Stretch" Padding="0,7" ToolTip.Tip="Player Management">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                          <lucide:LucideIcon Kind="Users" Size="13"/>
                          <TextBlock Text="Players" FontSize="12"/>
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="4"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).ServerSettingsCommand}"
                              CommandParameter="{Binding}"
                              Classes="secondary" HorizontalAlignment="Stretch" Padding="0,7" ToolTip.Tip="Server Settings">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                          <lucide:LucideIcon Kind="Settings" Size="13"/>
                          <TextBlock Text="Settings" FontSize="12"/>
                        </StackPanel>
                      </Button>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*, 6, *" IsVisible="{Binding ShowStoppedControls}">
                      <Button Grid.Column="0"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenFolderCommand}"
                              CommandParameter="{Binding}"
                              Classes="secondary" HorizontalAlignment="Stretch" Padding="0,7">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                          <lucide:LucideIcon Kind="FolderOpen" Size="14"/>
                          <TextBlock Text="Files"/>
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="2"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).ServerSettingsCommand}"
                              CommandParameter="{Binding}"
                              Classes="secondary" HorizontalAlignment="Stretch" Padding="0,7">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                          <lucide:LucideIcon Kind="Settings" Size="14"/>
                          <TextBlock Text="Settings"/>
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
