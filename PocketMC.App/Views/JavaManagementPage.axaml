<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PocketMC.App.ViewModels"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="PocketMC.App.Views.JavaManagementPage"
             x:DataType="vm:JavaManagementViewModel"
             Background="Transparent">

  <Grid Margin="36,20,36,24" RowDefinitions="Auto, Auto, *, Auto">
    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,18" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Command="{Binding NavigateBackCommand}"
                Classes="subtle"
                Padding="6"
                ToolTip.Tip="Back">
          <lucide:LucideIcon Kind="ArrowLeft" Size="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Button>
        <TextBlock Text="Java &amp; PHP Runtimes"
                   FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Manage the Java &amp; PHP runtimes required to run Minecraft and PocketMine servers."
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 FontSize="13"/>
    </StackPanel>

    <!-- Action Bar -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
      <Button Command="{Binding DownloadMissingCommand}"
              IsEnabled="{Binding CanDownloadMissing}"
              Classes="primary"
              Padding="14,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <lucide:LucideIcon Kind="Download" Size="15"/>
          <TextBlock Text="Download Missing" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <Button Command="{Binding AddCustomRuntimeCommand}"
              Classes="secondary"
              Padding="14,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <lucide:LucideIcon Kind="FolderPlus" Size="15"/>
          <TextBlock Text="Add Custom Runtime" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <Button Command="{Binding RefreshCommand}"
              Classes="subtle"
              Padding="12,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <lucide:LucideIcon Kind="RefreshCw" Size="15"/>
          <TextBlock Text="Refresh" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Runtime Cards -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="18" Margin="0,0,10,12">
        <!-- Java Runtimes Section -->
        <StackPanel Spacing="10">
          <TextBlock Text="Java Runtimes"
                     FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

          <ItemsControl ItemsSource="{Binding Runtimes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:JavaRuntimeItemViewModel">
                <Border Classes="card" Padding="14,12" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <!-- Version Tile -->
                    <Border Grid.Column="0"
                            Width="42" Height="42"
                            CornerRadius="8"
                            Background="{Binding StatusBackground}"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding VersionLabel}"
                                 FontSize="16" FontWeight="Bold"
                                 Foreground="{Binding BadgeForeground}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>

                    <!-- Name & Path/Size Detail + Progress -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="0,0,14,0">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontSize="14" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                      <TextBlock Text="{Binding DetailText}"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis"/>
                      <ProgressBar Value="{Binding Progress}"
                                   Minimum="0" Maximum="100"
                                   Height="4"
                                   Margin="0,4,0,0"
                                   IsVisible="{Binding IsDownloading}"/>
                    </StackPanel>

                    <!-- Pill Badge -->
                    <Border Grid.Column="2"
                            Background="{Binding BadgeBackground}"
                            CornerRadius="6"
                            Padding="10,4"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding BadgeText}"
                                 FontSize="11" FontWeight="Bold"
                                 Foreground="{Binding BadgeForeground}"/>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="Download"
                              Command="{Binding $parent[UserControl].((vm:JavaManagementViewModel)DataContext).DownloadRuntimeCommand}"
                              CommandParameter="{Binding}"
                              IsVisible="{Binding ShowDownloadButton}"
                              Classes="primary"
                              Padding="12,6"
                              FontSize="12"/>

                      <Button Command="{Binding $parent[UserControl].((vm:JavaManagementViewModel)DataContext).VerifyRuntimeCommand}"
                              CommandParameter="{Binding}"
                              IsVisible="{Binding ShowVerifyButton}"
                              Classes="subtle"
                              Padding="8,6"
                              ToolTip.Tip="Verify Java runtime binary">
                        <lucide:LucideIcon Kind="ShieldCheck" Size="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                      </Button>

                      <Button Command="{Binding $parent[UserControl].((vm:JavaManagementViewModel)DataContext).DeleteRuntimeCommand}"
                              CommandParameter="{Binding}"
                              IsVisible="{Binding ShowDeleteButton}"
                              Classes="subtle"
                              Padding="8,6"
                              ToolTip.Tip="Delete runtime">
                        <lucide:LucideIcon Kind="Trash2" Size="15" Foreground="#EF4444"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- PHP Runtimes Section -->
        <StackPanel Spacing="10">
          <TextBlock Text="PHP Runtimes (PocketMine-MP)"
                     FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

          <ItemsControl ItemsSource="{Binding PhpRuntimes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PhpRuntimeItemViewModel">
                <Border Classes="card" Padding="14,12" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <!-- Version Tile -->
                    <Border Grid.Column="0"
                            Width="42" Height="42"
                            CornerRadius="8"
                            Background="{Binding StatusBackground}"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding VersionLabel}"
                                 FontSize="13" FontWeight="Bold"
                                 Foreground="{Binding BadgeForeground}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>

                    <!-- Name & Path/Size Detail + Progress -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="0,0,14,0">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontSize="14" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                      <TextBlock Text="{Binding DetailText}"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis"/>
                      <ProgressBar Value="{Binding Progress}"
                                   Minimum="0" Maximum="100"
                                   Height="4"
                                   Margin="0,4,0,0"
                                   IsVisible="{Binding IsDownloading}"/>
                    </StackPanel>

                    <!-- Pill Badge -->
                    <Border Grid.Column="2"
                            Background="{Binding BadgeBackground}"
                            CornerRadius="6"
                            Padding="10,4"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding BadgeText}"
                                 FontSize="11" FontWeight="Bold"
                                 Foreground="{Binding BadgeForeground}"/>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="Download"
                              Command="{Binding $parent[UserControl].((vm:JavaManagementViewModel)DataContext).DownloadPhpRuntimeCommand}"
                              CommandParameter="{Binding}"
                              IsVisible="{Binding ShowDownloadButton}"
                              Classes="primary"
                              Padding="12,6"
                              FontSize="12"/>

                      <Button Command="{Binding $parent[UserControl].((vm:JavaManagementViewModel)DataContext).DeletePhpRuntimeCommand}"
                              CommandParameter="{Binding}"
                              IsVisible="{Binding ShowDeleteButton}"
                              Classes="subtle"
                              Padding="8,6"
                              ToolTip.Tip="Delete PHP runtime">
                        <lucide:LucideIcon Kind="Trash2" Size="15" Foreground="#EF4444"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer Status -->
    <TextBlock Grid.Row="3"
               Text="{Binding GlobalStatus}"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               FontSize="12"
               Margin="0,10,0,0"/>
  </Grid>
</UserControl>
