<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PocketMC.App.ViewModels"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="PocketMC.App.Views.AboutPage"
             x:DataType="vm:AboutViewModel">

  <Grid RowDefinitions="Auto, *">
    <!-- Top Header -->
    <Grid Grid.Row="0" Margin="28,20,28,12" ColumnDefinitions="Auto, *">
      <Button Grid.Column="0" Command="{Binding NavigateBackCommand}"
              Classes="secondary" Padding="10,7" Margin="0,0,14,0" VerticalAlignment="Center"
              ToolTip.Tip="Back (Esc)">
        <lucide:LucideIcon Kind="ArrowLeft" Size="16"/>
      </Button>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="About" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="{Binding AppVersion}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
      </StackPanel>
    </Grid>

    <!-- Main Scroll Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,0,28,28" Spacing="12" MaxWidth="920" HorizontalAlignment="Left">

        <!-- App Hero Card -->
        <Border Classes="card" Padding="20">
          <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Width="56" Height="56" CornerRadius="12" Margin="0,0,18,0"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
              <Image Source="avares://PocketMC.App/Assets/logo.png" Width="40" Height="40"/>
            </Border>

            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,14">
              <TextBlock Text="PocketMC" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Text="Local-first Minecraft server manager for Linux and macOS."
                         FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Text="by DS Labs · Selective Digital Studio"
                         FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
              <Button Command="{Binding OpenWebsiteCommand}" Classes="secondary" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <lucide:LucideIcon Kind="Globe" Size="14"/>
                  <TextBlock Text="Visit Website"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding OpenGitHubCommand}" Classes="secondary" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <lucide:LucideIcon Kind="Code" Size="14"/>
                  <TextBlock Text="View on GitHub"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding OpenWhatsNewCommand}" Classes="primary" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <lucide:LucideIcon Kind="Sparkles" Size="14"/>
                  <TextBlock Text="What's New"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding OpenStudioCommand}" Classes="secondary" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <lucide:LucideIcon Kind="ExternalLink" Size="14"/>
                  <TextBlock Text="DS Labs Portfolio"/>
                </StackPanel>
              </Button>
            </WrapPanel>
          </Grid>
        </Border>

        <!-- Team & Contributors Accordion (matches Windows CardExpander) -->
        <Expander Classes="card-expander" IsExpanded="True">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="Users" Size="20"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                 Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Team &amp; Contributors" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Founders, contributors, helpers, and community supporters"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="10">
            <!-- Founders -->
            <TextBlock Text="Founders" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <WrapPanel>
              <Button Command="{Binding OpenDivyCommand}" Classes="secondary"
                      Padding="8,6" CornerRadius="8" Width="210" Height="54"
                      HorizontalContentAlignment="Left" Margin="0,0,10,8"
                      ToolTip.Tip="Divy Viradiya · Co-Founder (github.com/divyviradiya2)">
                <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" ClipToBounds="True"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                          Margin="0,0,10,0">
                    <Image Source="avares://PocketMC.App/Assets/avatar_divyviradiya.png" Stretch="UniformToFill"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Divy Viradiya" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Co-Founder" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                </Grid>
              </Button>

              <Button Command="{Binding OpenSahajCommand}" Classes="secondary"
                      Padding="8,6" CornerRadius="8" Width="210" Height="54"
                      HorizontalContentAlignment="Left" Margin="0,0,10,8"
                      ToolTip.Tip="Sahaj Italiya · Co-Founder (github.com/SizWinz)">
                <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" ClipToBounds="True"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                          Margin="0,0,10,0">
                    <Image Source="avares://PocketMC.App/Assets/avatar_sahajitaliya.png" Stretch="UniformToFill"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Sahaj Italiya" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Co-Founder" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                </Grid>
              </Button>
            </WrapPanel>

            <!-- Contributors & Helpers -->
            <TextBlock Text="Contributors &amp; Helpers" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            <WrapPanel>
              <Button Command="{Binding OpenJohndinglesinCommand}" Classes="secondary"
                      Padding="8,6" CornerRadius="8" Width="210" Height="54"
                      HorizontalContentAlignment="Left" Margin="0,0,10,8"
                      ToolTip.Tip="Johndinglesin · Helper (Testing, Dev &amp; Social Media)">
                <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" ClipToBounds="True"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                          Margin="0,0,10,0">
                    <Image Source="avares://PocketMC.App/Assets/avatar_johndinglesin.png" Stretch="UniformToFill"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Johndinglesin" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Helper" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                </Grid>
              </Button>
            </WrapPanel>

            <!-- Donators -->
            <TextBlock Text="Donators" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            <WrapPanel>
              <Button Command="{Binding OpenNexViceCommand}" Classes="secondary"
                      Padding="8,6" CornerRadius="8" Width="210" Height="54"
                      HorizontalContentAlignment="Left" Margin="0,0,10,0"
                      ToolTip.Tip="NexVice (@nexvice) · Donator">
                <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                  <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" ClipToBounds="True"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                          Margin="0,0,10,0">
                    <Image Source="avares://PocketMC.App/Assets/avatar_nexvice.png" Stretch="UniformToFill"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="NexVice" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Donator" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                </Grid>
              </Button>
            </WrapPanel>
          </StackPanel>
        </Expander>

        <!-- Storage & Data Directory Accordion -->
        <Expander Classes="card-expander" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="HardDrive" Size="18"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                 Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Storage &amp; Data Directory" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding CurrentDataRoot}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*, Auto, Auto">
              <TextBox Grid.Column="0" Text="{Binding CurrentDataRoot}" IsReadOnly="True"
                       Margin="0,0,8,0"/>
              <Button Grid.Column="1" Command="{Binding ChangeDataRootCommand}"
                      Classes="secondary" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <lucide:LucideIcon Kind="FolderOpen" Size="14"/>
                  <TextBlock Text="Change Root..."/>
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Command="{Binding OpenDataRootFolderCommand}"
                      Classes="secondary" ToolTip.Tip="Open Folder">
                <lucide:LucideIcon Kind="ExternalLink" Size="14"/>
              </Button>
            </Grid>
            <TextBlock Text="{Binding ChangeRootStatus}" FontSize="12"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                       IsVisible="{Binding ChangeRootStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </Expander>

        <!-- Responsive 2-Column Section: Community & Support (matches Windows AboutPage bottom grid) -->
        <Grid ColumnDefinitions="*, 14, *">
          <!-- Community Card -->
          <Border Grid.Column="0" Classes="card" Padding="20" VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto, Auto, *">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                <lucide:LucideIcon Kind="MessageCircle" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Community" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
              </StackPanel>

              <TextBlock Grid.Row="1"
                         Text="Join our Discord server to get help, share tips, and connect with other PocketMC users."
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,0,0,14"/>

              <WrapPanel Grid.Row="2" VerticalAlignment="Bottom">
                <Button Command="{Binding OpenDiscordCommand}" Classes="primary" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="Users" Size="14"/>
                    <TextBlock Text="Join Discord"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding CopyDiscordInviteCommand}" Classes="secondary" Content="Copy Invite" Margin="0,0,8,8"/>
                <Button Command="{Binding OpenInstagramCommand}" Classes="secondary" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="Camera" Size="14"/>
                    <TextBlock Text="Instagram"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding OpenYouTubeCommand}" Classes="secondary" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="Video" Size="14"/>
                    <TextBlock Text="YouTube"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding OpenRedditCommand}" Classes="secondary" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="MessageSquare" Size="14"/>
                    <TextBlock Text="Reddit"/>
                  </StackPanel>
                </Button>
              </WrapPanel>
            </Grid>
          </Border>

          <!-- Support & Feedback Card -->
          <Border Grid.Column="2" Classes="card" Padding="20" VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto, Auto, *">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                <lucide:LucideIcon Kind="Heart" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Support &amp; Feedback" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
              </StackPanel>

              <TextBlock Grid.Row="1"
                         Text="Support the development of PocketMC! If you love this project and find it useful, consider buying us a coffee or submitting feedback."
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,0,0,14"/>

              <WrapPanel Grid.Row="2" VerticalAlignment="Bottom">
                <Button Command="{Binding OpenDonationCommand}" Classes="primary" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="Heart" Size="14"/>
                    <TextBlock Text="Buy Me a Coffee"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding OpenFeedbackCommand}" Classes="secondary" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="ExternalLink" Size="14"/>
                    <TextBlock Text="Submit Feedback Form"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding OpenDiscordCommand}" Classes="secondary" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="Users" Size="14"/>
                    <TextBlock Text="Get Help on Discord"/>
                  </StackPanel>
                </Button>
              </WrapPanel>
            </Grid>
          </Border>
        </Grid>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
