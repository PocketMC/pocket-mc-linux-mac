<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="using:Lucide.Avalonia"
        x:Class="PocketMC.App.Views.Tunnel.PreStartAgentWarningWindow"
        Title="Agent Not Connected"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource ApplicationBackgroundBrush}">

  <Grid Margin="22" RowDefinitions="Auto, *, Auto">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
      <lucide:LucideIcon Kind="TriangleAlert" Size="20" Foreground="#F59E0B" VerticalAlignment="Center"/>
      <TextBlock Text="Agent Not Connected"
                 FontSize="18" FontWeight="Bold"
                 Foreground="#F59E0B"
                 VerticalAlignment="Center"/>
    </StackPanel>

    <TextBlock Grid.Row="1"
               Text="Your PlayIt.gg agent is not connected. Public addresses will not work until the agent is running."
               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               FontSize="13"
               TextWrapping="Wrap"
               Margin="0,0,0,20"/>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Start Anyway"
              Click="BtnStartAnyway_Click"
              Classes="secondary"
              Width="140"/>
      <Button Content="Connect Agent"
              Click="BtnConnectAgent_Click"
              Classes="primary"
              Width="140"/>
    </StackPanel>
  </Grid>
</Window>
