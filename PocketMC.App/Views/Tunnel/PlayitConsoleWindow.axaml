<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PocketMC.App.Views.Tunnel.PlayitConsoleWindow"
        Title="Playit Agent Console"
        Width="880" Height="560"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid RowDefinitions="Auto, *">
        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *">
                <!-- Status Badge -->
                <Border Grid.Column="0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="Running" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Auto-scroll -->
                <ToggleButton x:Name="BtnAutoScroll"
                              Grid.Column="1"
                              Content="Auto-scroll"
                              IsChecked="True"
                              CornerRadius="6"
                              Padding="12,6"
                              Margin="0,0,8,0"
                              Cursor="Hand"
                              VerticalAlignment="Center"/>

                <!-- Copy Logs -->
                <Button x:Name="BtnCopyLogs"
                        Grid.Column="2"
                        Content="Copy Logs"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        VerticalAlignment="Center"/>

                <!-- Clear -->
                <Button x:Name="BtnClearLogs"
                        Grid.Column="3"
                        Content="Clear"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        VerticalAlignment="Center"/>

                <!-- Search -->
                <TextBox x:Name="TxtSearch"
                         Grid.Column="4"
                         Watermark="Search logs..."
                         CornerRadius="6"
                         Padding="10,6"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- LOG VIEWER -->
        <ScrollViewer x:Name="LogScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource ConsoleBackgroundBrush}"
                      Padding="14">
            <SelectableTextBlock x:Name="TxtLogs"
                                 FontFamily="Consolas, Menlo, Monaco, 'Courier New', monospace"
                                 FontSize="13"
                                 Foreground="{DynamicResource ConsoleTextBrush}"
                                 LineHeight="20"
                                 TextWrapping="NoWrap"/>
        </ScrollViewer>
    </Grid>
</Window>
