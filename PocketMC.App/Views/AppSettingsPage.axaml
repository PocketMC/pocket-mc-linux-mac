<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PocketMC.App.ViewModels"
             xmlns:settingsVm="using:PocketMC.App.ViewModels.Settings"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="PocketMC.App.Views.AppSettingsPage"
             x:DataType="vm:AppSettingsViewModel">

  <Grid RowDefinitions="Auto, *, Auto">
    <!-- Page Header -->
    <Grid Grid.Row="0" Margin="28,20,28,14" ColumnDefinitions="*, Auto">
      <StackPanel Grid.Column="0">
        <TextBlock Text="App Settings" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="{Binding StatusMessage, FallbackValue='Configure PocketMC behavior, appearance, backups, AI summarization, and diagnostics.'}"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
      </StackPanel>
      <Button Grid.Column="1" Command="{Binding SaveSettingsCommand}" Classes="primary" Padding="18,9" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <lucide:LucideIcon Kind="Save" Size="15"/>
          <TextBlock Text="Save Settings"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- 10+ Accordion Sections matching Windows AppSettingsPage.xaml -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,0,28,28" Spacing="12" MaxWidth="920" HorizontalAlignment="Left">

        <!-- 1. App Behavior -->
        <Expander Classes="card-expander" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="SlidersHorizontal" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="App Behavior" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Control tray minimization, sleep prevention, telemetry, and console buffer." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel>
                <TextBlock Text="Start minimized to tray" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="Keep the main window hidden on launch and run from the system tray." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel>
                <TextBlock Text="Minimize to tray on close" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="Keep PocketMC and running servers active in the background when closed." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel>
                <TextBlock Text="Prevent system sleep while servers run" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="Inhibits sleep via systemd-inhibit / caffeinate while any server is active." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepComputerAwakeWhileServersRunning, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel>
                <TextBlock Text="Anonymous usage telemetry" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="Share non-identifying crash &amp; usage counters to improve PocketMC." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableTelemetry, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>
            <Grid ColumnDefinitions="*, 140">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Console log line limit" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="Maximum live entries kept in console scrollback buffer." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <NumericUpDown Grid.Column="1" Value="{Binding ConsoleBufferSize, Mode=TwoWay}" Minimum="500" Maximum="50000" Increment="500"/>
            </Grid>
          </StackPanel>
        </Expander>

        <!-- 2. Storage & Data Root -->
        <Expander Classes="card-expander" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="HardDrive" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Storage &amp; Data Directory" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding DataRootPath}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="10">
            <TextBlock Text="Instances, downloaded Java/PHP runtimes, backups, and logs live under this root folder."
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*, 8, Auto, 8, Auto">
              <TextBox Grid.Column="0" Text="{Binding DataRootPath}" IsReadOnly="True"/>
              <Button Grid.Column="2" Content="Change..." Classes="secondary" Command="{Binding ChangeDataRootCommand}"/>
              <Button Grid.Column="4" Content="Open Folder" Classes="secondary" Command="{Binding OpenDataRootFolderCommand}"/>
            </Grid>
          </StackPanel>
        </Expander>

        <!-- 3. Appearance & Wallpaper Backdrop -->
        <Expander Classes="card-expander" IsExpanded="True">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="Palette" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Customize theme, accent colors, frosted wallpaper blur, and tint opacity." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*, 180">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="App Theme" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="Match system appearance or force Dark / Light mode." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch"/>
            </Grid>

            <Grid ColumnDefinitions="*, 180">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Window Backdrop Style" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="BlurredWallpaper applies Windows FakeMica translucency." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding BackdropOptions}" SelectedItem="{Binding WindowBackdrop}" HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- Custom Wallpaper Row -->
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Custom Background Image" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="{Binding CustomBgDisplayName}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Browse Image" Classes="secondary" Command="{Binding BrowseCustomWallpaperCommand}"/>
                <Button Content="Reset Default" Classes="secondary" Command="{Binding ResetWallpaperCommand}"/>
              </StackPanel>
            </Grid>

            <!-- Blur Radius -->
            <Grid ColumnDefinitions="*, 220">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Blur Intensity" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="{Binding WallpaperBlurRadius, StringFormat='{}{0:F0} px'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <Slider Grid.Column="1" Minimum="0" Maximum="120" Value="{Binding WallpaperBlurRadius, Mode=TwoWay}"/>
            </Grid>

            <!-- Tint Opacity -->
            <Grid ColumnDefinitions="*, 220">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Backdrop Tint Darkness" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="{Binding WallpaperTintOpacity, StringFormat='{}{0:P0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <Slider Grid.Column="1" Minimum="0.1" Maximum="0.95" Value="{Binding WallpaperTintOpacity, Mode=TwoWay}"/>
            </Grid>

            <!-- Accent Swatches + Custom Hex -->
            <StackPanel Spacing="8">
              <TextBlock Text="Accent Color" FontSize="14" FontWeight="Medium"/>
              <ItemsControl ItemsSource="{Binding AccentColorPresets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AccentPresetOption">
                    <Button Command="{Binding $parent[ItemsControl].((vm:AppSettingsViewModel)DataContext).ApplyPresetColorCommand}"
                            CommandParameter="{Binding Hex}"
                            Background="{Binding SwatchBrush}"
                            Width="30" Height="30" CornerRadius="15" Margin="0,0,8,8"
                            BorderBrush="#60FFFFFF" BorderThickness="1"
                            ToolTip.Tip="{Binding Name}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*, 8, Auto" MaxWidth="340" HorizontalAlignment="Left">
                <TextBox Grid.Column="0" Text="{Binding CustomAccentColor, Mode=TwoWay}" Watermark="#008B00"/>
                <Button Grid.Column="2" Content="Apply Hex" Classes="primary" Command="{Binding SaveSettingsCommand}"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Expander>

        <!-- 4. Notifications -->
        <Expander Classes="card-expander" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="Bell" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Notifications" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Manage native desktop alerts for server events." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Text="Server Online Notification" VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableServerOnlineNotifications, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Text="Playit Agent Connect Notification" VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAgentConnectNotifications, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Text="Remote Control Online Notification" VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableRemoteControlNotifications, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Text="AI Summary Complete Notification" VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAiSummaryNotifications, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>
          </StackPanel>
        </Expander>

        <!-- 5. Discord Rich Presence + Live Profile Preview -->
        <Expander Classes="card-expander" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="Gamepad2" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Discord Rich Presence" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Customize live Discord activity card while hosting servers." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel>
                <TextBlock Text="Enable Discord Rich Presence" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="Broadcast server activity on your Discord profile." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableDiscordRpc, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>

            <!-- Live Side-by-Side Preview Cards -->
            <TextBlock Text="Live Profile Preview" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Grid ColumnDefinitions="*, 14, *">
              <!-- Active Card -->
              <Border Grid.Column="0" Classes="card-secondary" Padding="14">
                <StackPanel Spacing="8">
                  <TextBlock Text="Playing PocketMC" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <Grid ColumnDefinitions="Auto, 12, *">
                    <Image Grid.Column="0" Source="avares://PocketMC.App/Assets/logo.png" Width="48" Height="48"/>
                    <StackPanel Grid.Column="2" Spacing="2">
                      <TextBlock Text="{Binding PreviewServerTitle}" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="{Binding PreviewActivityLine1}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock Text="{Binding PreviewActivityLine2}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock Text="02:30 elapsed" FontSize="11" Foreground="#23A55A" IsVisible="{Binding PreviewUptimeVisible}"/>
                    </StackPanel>
                  </Grid>
                  <Button Content="Download PocketMC" Classes="secondary" HorizontalAlignment="Stretch"
                          IsVisible="{Binding PreviewDownloadVisible}"/>
                </StackPanel>
              </Border>

              <!-- Idle Card -->
              <Border Grid.Column="2" Classes="card-secondary" Padding="14" Opacity="0.85">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Idle State" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="Hidden when idle" FontSize="11" Foreground="#F87171"
                               IsVisible="{Binding !PreviewIdleVisible}"/>
                  </Grid>
                  <Grid ColumnDefinitions="Auto, 12, *">
                    <Image Grid.Column="0" Source="avares://PocketMC.App/Assets/logo.png" Width="48" Height="48"/>
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="PocketMC" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Managing Servers" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Presence Toggles -->
            <WrapPanel>
              <CheckBox Content="Show when idle" IsChecked="{Binding DiscordRpcShowIdle, Mode=TwoWay}" Margin="0,0,18,6"/>
              <CheckBox Content="Show server name" IsChecked="{Binding DiscordRpcShowServerName, Mode=TwoWay}" Margin="0,0,18,6"/>
              <CheckBox Content="Show tunnel address" IsChecked="{Binding DiscordRpcShowServerAddress, Mode=TwoWay}" Margin="0,0,18,6"/>
              <CheckBox Content="Show player count" IsChecked="{Binding DiscordRpcShowPlayerCount, Mode=TwoWay}" Margin="0,0,18,6"/>
              <CheckBox Content="Show version &amp; engine" IsChecked="{Binding DiscordRpcShowVersion, Mode=TwoWay}" Margin="0,0,18,6"/>
              <CheckBox Content="Show uptime timer" IsChecked="{Binding DiscordRpcShowUptime, Mode=TwoWay}" Margin="0,0,18,6"/>
              <CheckBox Content="Show download button" IsChecked="{Binding DiscordRpcShowDownloadButton, Mode=TwoWay}" Margin="0,0,18,6"/>
            </WrapPanel>
          </StackPanel>
        </Expander>

        <!-- 6. Cloud Backups -->
        <Expander Classes="card-expander" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="Cloud" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Cloud Backups" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Connect Google Drive, Dropbox, or OneDrive for off-site world sync." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="12" DataContext="{Binding CloudBackupsVm}">
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Text="Enable Cloud Backup Synchronization" FontWeight="Medium" VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableCloudBackups, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Text="Auto-upload manual world backups" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding UploadOnManualBackup, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Text="Auto-upload scheduled backups" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding UploadOnScheduledBackup, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>

            <ItemsControl ItemsSource="{Binding ProviderViewModels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="settingsVm:CloudProviderViewModel">
                  <Border Classes="card-secondary" Margin="0,6,0,0" Padding="12">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                      <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding StatusDotBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AccountInfo}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Connect" Classes="primary" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnected}"/>
                        <Button Content="Disconnect" Classes="secondary" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}"/>
                        <Button Classes="secondary" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh Status">
                          <lucide:LucideIcon Kind="RefreshCw" Size="14"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>

        <!-- 7. API Configuration -->
        <Expander Classes="card-expander" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="KeyRound" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="API Configuration" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Manage CurseForge Eternal API key for marketplace &amp; modpack installs." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="6">
            <TextBlock Text="CurseForge API Key" FontSize="13" FontWeight="Medium"/>
            <TextBox Text="{Binding CurseForgeApiKey, Mode=TwoWay}" PasswordChar="*" Watermark="Enter optional CurseForge API key"/>
          </StackPanel>
        </Expander>

        <!-- 8. AI Session Summarization & Ollama -->
        <Expander Classes="card-expander" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="Sparkles" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="AI Session Summarization &amp; Crash Analysis" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Configure Gemini, OpenAI, Anthropic, or Local/Cloud Ollama models." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Text="Enable Automatic Session Summarization" FontWeight="Medium" VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAiSummarization, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>

            <Grid ColumnDefinitions="*, 14, *">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="AI Provider" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding AiProviderOptions}" SelectedItem="{Binding AiProvider}" HorizontalAlignment="Stretch"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Model Name" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding AiModel, Mode=TwoWay}" Watermark="gemini-2.5-flash / llama3.2:3b"/>
              </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
              <TextBlock Text="API Key" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBox Text="{Binding AiApiKey, Mode=TwoWay}" PasswordChar="*" Watermark="Required for cloud providers"/>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Custom / Ollama Endpoint URL" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBox Text="{Binding AiEndpoint, Mode=TwoWay}" Watermark="http://localhost:11434"/>
            </StackPanel>

            <!-- Ollama Management Controls -->
            <Border Classes="card-secondary" IsVisible="{Binding IsOllamaProvider}" Padding="12">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, 160">
                  <TextBlock Text="Ollama Mode (Local Daemon vs Cloud)" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding OllamaModeOptions}" SelectedItem="{Binding OllamaMode}" HorizontalAlignment="Stretch"/>
                </Grid>
                <Grid ColumnDefinitions="*, Auto, 8, Auto">
                  <TextBlock Grid.Column="0" Text="{Binding OllamaDaemonStatus}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="Check Daemon" Classes="secondary" Command="{Binding CheckOllamaDaemonCommand}"/>
                  <Button Grid.Column="3" Content="Manage Models..." Classes="primary" Command="{Binding OpenOllamaModelManagerCommand}"/>
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="18">
              <CheckBox Content="Auto-summarize on clean Stop" IsChecked="{Binding AutoSummarizeOnStop, Mode=TwoWay}"/>
              <CheckBox Content="Auto-summarize on Crash" IsChecked="{Binding AutoSummarizeOnCrash, Mode=TwoWay}"/>
            </StackPanel>
          </StackPanel>
        </Expander>

        <!-- 9. Software Updates -->
        <Expander Classes="card-expander" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="RefreshCw" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Software Updates" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentVersionLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*, 180">
              <TextBlock Text="Release Channel" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding UpdateChannelOptions}" SelectedItem="{Binding UpdateChannel}" HorizontalAlignment="Stretch"/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Text="Check for updates automatically on startup" VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAutoUpdates, Mode=TwoWay}" OnContent="" OffContent=""/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Content="Check for Updates" Classes="secondary" Command="{Binding CheckForUpdatesCommand}"/>
              <TextBlock Text="{Binding UpdateCheckStatus}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Expander>

        <!-- 10. Keyboard Shortcuts -->
        <Expander Classes="card-expander" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="Keyboard" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Keyboard Shortcuts" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Quick navigation &amp; console hotkeys matching PocketMC Windows." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Text="Dashboard / Tunnel / Remote Control"/>
              <TextBlock Grid.Column="1" Text="Ctrl+1 / Ctrl+2 / Ctrl+3" FontFamily="Monospace" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Text="Runtimes / Settings / About / News"/>
              <TextBlock Grid.Column="1" Text="Ctrl+4 / Ctrl+5 / Ctrl+6 / Ctrl+7" FontFamily="Monospace" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Text="Toggle Navigation Pane"/>
              <TextBlock Grid.Column="1" Text="Ctrl+B" FontFamily="Monospace" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Text="Navigate Back / Forward"/>
              <TextBlock Grid.Column="1" Text="Esc / Alt+Left / Alt+Right" FontFamily="Monospace" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
          </StackPanel>
        </Expander>

        <!-- 11. Backup & Restore Configuration -->
        <Expander Classes="card-expander" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="Archive" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Backup &amp; Restore Configuration" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Export granular settings JSON or reset to defaults." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <WrapPanel Orientation="Horizontal">
            <Button Content="Backup Settings..." Classes="primary" Click="BtnExportBackup_Click" Margin="0,0,8,8"/>
            <Button Content="Restore from Backup..." Classes="secondary" Click="BtnRestoreBackup_Click" Margin="0,0,8,8"/>
            <Button Content="Reset to Defaults" Classes="secondary" Command="{Binding ResetToDefaultsCommand}" Margin="0,0,8,8"/>
          </WrapPanel>
        </Expander>

        <!-- 12. Diagnostics & Support -->
        <Expander Classes="card-expander" IsExpanded="False">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto, *">
              <lucide:LucideIcon Grid.Column="0" Kind="Activity" Size="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Diagnostics &amp; Off-site Disaster Recovery" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Verify upstream API reachability and set secondary backup mirror path." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Check Upstream Health" Classes="secondary" Command="{Binding CheckDependenciesCommand}"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding DependencyHealthItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DependencyHealthRow">
                  <Grid ColumnDefinitions="140, 100, *" Margin="0,3">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="4">
              <TextBlock Text="External Off-site Backup Directory" FontSize="13" FontWeight="Medium"/>
              <Grid ColumnDefinitions="*, 8, Auto">
                <TextBox Grid.Column="0" Text="{Binding ExternalBackupDirectory, Mode=TwoWay}" Watermark="Optional local mirror / NAS mount"/>
                <Button Grid.Column="2" Content="Browse..." Classes="secondary" Command="{Binding BrowseExternalBackupCommand}"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
