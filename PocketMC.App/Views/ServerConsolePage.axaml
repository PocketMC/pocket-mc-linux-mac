<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PocketMC.App.ViewModels"
             xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
             x:Class="PocketMC.App.Views.ServerConsolePage"
             x:DataType="vm:ServerConsoleViewModel"
             x:CompileBindings="True"
             Margin="16">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Top Toolbar: Console actions matching Windows ServerConsolePage.xaml -->
        <Grid Grid.Row="0" Margin="0,0,0,12" ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto">
            <!-- Back Button -->
            <Button Grid.Column="0" Command="{Binding GoBackCommand}"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="10,6" Margin="0,0,12,0" CornerRadius="6" Cursor="Hand"
                    ToolTip.Tip="Back to Dashboard (Escape)">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <lucide:LucideIcon Kind="ArrowLeft" Size="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Back" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Auto-scroll Toggle -->
            <ToggleButton Grid.Column="1" IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                          Content="Auto-scroll" FontSize="12" FontWeight="Medium"
                          Padding="12,6" Margin="0,0,12,0" CornerRadius="6" Cursor="Hand"/>

            <!-- Copy Logs -->
            <Button Grid.Column="2" Command="{Binding CopyLogsCommand}"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="10,6" Margin="0,0,12,0" CornerRadius="6" Cursor="Hand"
                    ToolTip.Tip="Copy logs to clipboard">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <lucide:LucideIcon Kind="Copy" Size="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Copy Logs" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Search Logs Input -->
            <TextBox Grid.Column="3" Text="{Binding SearchQuery, Mode=TwoWay}"
                     Watermark="Search logs..." FontSize="12"
                     Margin="0,0,6,0" MinWidth="160" Height="32" CornerRadius="6"
                     VerticalContentAlignment="Center"/>

            <!-- Regex ToggleButton -->
            <ToggleButton Grid.Column="4" IsChecked="{Binding IsRegexEnabled, Mode=TwoWay}"
                          Content=".*" FontSize="12" FontWeight="Bold"
                          Width="32" Height="32" Padding="0" Margin="0,0,12,0" CornerRadius="6"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          Cursor="Hand" ToolTip.Tip="Use Regular Expressions"/>

            <!-- Log Filter ToggleButtons -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
                <ToggleButton Content="Chat" IsChecked="{Binding IsFilterChat, Mode=TwoWay}" Padding="8,4" FontSize="11" CornerRadius="4" Cursor="Hand"/>
                <ToggleButton Content="Info" IsChecked="{Binding IsFilterInfo, Mode=TwoWay}" Padding="8,4" FontSize="11" CornerRadius="4" Cursor="Hand"/>
                <ToggleButton Content="Warn" IsChecked="{Binding IsFilterWarn, Mode=TwoWay}" Padding="8,4" FontSize="11" CornerRadius="4" Cursor="Hand"/>
                <ToggleButton Content="Error" IsChecked="{Binding IsFilterError, Mode=TwoWay}" Padding="8,4" FontSize="11" CornerRadius="4" Cursor="Hand"/>
                <ToggleButton Content="Sys" IsChecked="{Binding IsFilterSystem, Mode=TwoWay}" Padding="8,4" FontSize="11" CornerRadius="4" Cursor="Hand"/>
            </StackPanel>

            <!-- AI Summary Action Button -->
            <Button Grid.Column="6" Command="{Binding NavigateToAiDiagnosticCommand}"
                    Classes="ai-action"
                    Padding="10,6" CornerRadius="6" Cursor="Hand"
                    ToolTip.Tip="Generate AI session summary">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <lucide:LucideIcon Kind="Sparkles" Size="14" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="AI Summary" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Console Terminal Area -->
        <Border Grid.Row="1" 
                Background="#1E1E1E" 
                CornerRadius="8" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                Padding="12">
            <Grid RowDefinitions="Auto, Auto, *">
                <!-- Terminal Header Bar -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource ControlFillColorDefaultBrush}" 
                        CornerRadius="6" 
                        Padding="12,8" 
                        Margin="0,0,0,10"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedInstance.Name, StringFormat='{}Active Terminal: {0}'}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding LogEntryCount, StringFormat='{}{0} entries'}" Grid.Column="1"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Crash Diagnostics Warning Banner -->
                <Border Grid.Row="1" 
                        Background="#EE1A1A1A" 
                        BorderBrush="#FF4444" 
                        BorderThickness="1,1,1,2" 
                        CornerRadius="8" 
                        Padding="12,8" 
                        Margin="0,0,0,12" 
                        IsVisible="{Binding IsCrashed}">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <lucide:LucideIcon Kind="ShieldAlert" Size="16" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                            <TextBlock Text="Critical Crash Detected! Run AI Diagnostics to analyze root causes and fix errors." 
                                       Foreground="#FF6B6B" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding NavigateToAiDiagnosticCommand}" 
                                Classes="ai-action" CornerRadius="4" Padding="10,4" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <lucide:LucideIcon Kind="Sparkles" Size="12" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Analyze with AI" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Scrollable Log Container -->
                <ScrollViewer Grid.Row="2" Name="LogScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogLine">
                                <SelectableTextBlock Text="{Binding Text}"
                                                     Foreground="{Binding ColorBrush}"
                                                     FontFamily="Cascadia Code, JetBrains Mono, Fira Code, Consolas, Menlo, Monospace"
                                                     FontSize="13"
                                                     LineHeight="20"
                                                     TextWrapping="Wrap"
                                                     Margin="0,0,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Command Input Box -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,8,0,0">
            <TextBox Grid.Column="0" 
                     Text="{Binding CommandInput, Mode=TwoWay}" 
                     KeyDown="OnCommandBoxKeyDown" 
                     Watermark="Type a command..." 
                     FontFamily="Cascadia Code, JetBrains Mono, Fira Code, Consolas, Menlo, Monospace" 
                     FontSize="13" 
                     Padding="12,8"
                     VerticalContentAlignment="Center"
                     Height="38"
                     CornerRadius="6"
                     Margin="0,0,8,0"/>
            <Button Grid.Column="1" Command="{Binding SendCommandCommand}" Cursor="Hand"
                    Padding="16,0" Height="38"
                    Background="{DynamicResource AccentPrimaryBrush}" Foreground="White"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <lucide:LucideIcon Kind="Send" Size="14" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="Send" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
