<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PocketMC.App.ViewModels"
        xmlns:views="using:PocketMC.App.Views"
        xmlns:lucide="using:Lucide.Avalonia"
        x:Class="PocketMC.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PocketMC"
        TransparencyLevelHint="Mica, AcrylicBlur, Blur, None"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        MinWidth="1024" MinHeight="680" Width="1160" Height="760">

  <Window.Styles>
    <Style Selector="Button.nav-item">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="8,9"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.nav-item.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.nav-item-footer">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="8,8"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.nav-item-footer:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.nav-item-footer.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Styles>

  <Grid x:Name="RootGrid">
    <!-- Wallpaper FakeMica Layer -->
    <Image x:Name="WallpaperBlurLayer"
           Stretch="UniformToFill"
           IsVisible="False"
           IsHitTestVisible="False"/>
    <Border x:Name="WallpaperTintOverlay"
            IsVisible="False"
            IsHitTestVisible="False"/>

    <!-- Solid fallback tint shown ONLY when wallpaper backdrop is inactive -->
    <Border x:Name="BackdropTintLayer"
            Background="{DynamicResource WindowBackgroundBrush}"
            IsVisible="{Binding !IsWallpaperActive}"
            IsHitTestVisible="False"/>

    <!-- Root shell grid: Update banner, TitleBar, Client area -->
    <Grid RowDefinitions="Auto, 40, *">

      <!-- Update Notification Banner -->
      <Border Grid.Row="0"
              IsVisible="{Binding IsUpdateBannerVisible}"
              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="14,8">
        <Grid ColumnDefinitions="*, Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <ProgressBar Width="120" Height="6"
                         Minimum="0" Maximum="100"
                         Value="{Binding UpdateDownloadPercent, Mode=OneWay}"
                         IsIndeterminate="{Binding IsUpdateDownloading}"
                         IsVisible="{Binding IsUpdateDownloading}"
                         VerticalAlignment="Center"/>
            <TextBlock Text="{Binding UpdateStatusMessage}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="13"
                       FontWeight="Medium"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Restart to update"
                    Classes="primary"
                    Padding="10,4"
                    Command="{Binding RestartAndApplyUpdateCommand}"
                    IsVisible="{Binding IsUpdateReadyToApply}"
                    ToolTip.Tip="Stop all servers first if any are running"/>
            <Button Classes="subtle"
                    Padding="6,4"
                    Command="{Binding DismissUpdateBannerCommand}"
                    ToolTip.Tip="Dismiss">
              <lucide:LucideIcon Kind="X" Size="14"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Custom TitleBar Header (40px) -->
      <Border Grid.Row="1"
              Background="Transparent"
              PointerPressed="TitleBar_OnPointerPressed">
        <Grid Margin="{Binding TitleBarContentMargin, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
              VerticalAlignment="Center"
              ColumnDefinitions="Auto, *, Auto, Auto">

          <!-- Left: Back button + Brand Icon + App Title & Breadcrumb -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
            <Button Command="{Binding NavigateBackCommand}"
                    IsVisible="{Binding CanNavigateBack}"
                    Classes="subtle"
                    Padding="5,4"
                    ToolTip.Tip="Back (Esc / Alt+Left)">
              <lucide:LucideIcon Kind="ArrowLeft" Size="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>
            <Image Source="avares://PocketMC.App/Assets/logo.png"
                   Width="18" Height="18"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
            <TextBlock Text="PocketMC"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="/"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentBreadcrumb}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Right-Aligned Context Pill (Server Name & Status Dot matching Windows TitleBarContextBorder) -->
          <Border Grid.Column="2"
                  Background="#14FFFFFF"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Height="24"
                  Padding="10,0"
                  Margin="0,0,10,0"
                  IsVisible="{Binding IsTitleBarContextVisible}"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding TitleBarTitle}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center"/>
              <TextBlock Text="•"
                         FontSize="12"
                         Foreground="{DynamicResource TextMutedBrush}"
                         VerticalAlignment="Center"/>
              <Ellipse Width="7" Height="7" Fill="{Binding TitleBarStatusColor}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding TitleBarStatusText}"
                         Foreground="{Binding TitleBarStatusColor}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- Far Right: System RAM Status Pill matching Windows GlobalHealthBorder -->
          <Border Grid.Column="3"
                  Background="#18FFFFFF"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Height="24"
                  Padding="10,0"
                  Margin="0,0,16,0"
                  IsVisible="{Binding IsGlobalHealthVisible}"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding GlobalHealthStatusText}"
                       Foreground="{Binding GlobalHealthStatusColor}"
                       FontSize="11"
                       FontWeight="Medium"
                       VerticalAlignment="Center"/>
          </Border>
        </Grid>
      </Border>

      <!-- Main Client Content Grid -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto, *">

        <!-- Collapsible NavigationView Sidebar Rail -->
        <Border Grid.Column="0"
                Width="{Binding SidebarWidth}"
                Background="#0AFFFFFF"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,1,0"
                Padding="8,10">
          <Grid RowDefinitions="Auto, *, Auto">

            <!-- Hamburger Rail Toggle -->
            <Button Grid.Row="0"
                    Command="{Binding TogglePaneCommand}"
                    Classes="subtle"
                    HorizontalAlignment="Left"
                    Padding="9,7"
                    Margin="2,0,0,8"
                    ToolTip.Tip="Toggle Navigation Pane (Ctrl+B)">
              <lucide:LucideIcon Kind="Menu" Size="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Button>

            <!-- Primary Navigation Items -->
            <StackPanel Grid.Row="1" Spacing="3">
              <!-- Dashboard -->
              <Button Command="{Binding NavigateDashboardCommand}"
                      Classes="nav-item"
                      Classes.active="{Binding IsDashboardSelected}"
                      ToolTip.Tip="Dashboard (Ctrl+1)">
                <Grid ColumnDefinitions="Auto, Auto, *">
                  <Border Grid.Column="0"
                          Width="3" Height="16" CornerRadius="2" Margin="0,0,8,0"
                          Background="{DynamicResource AccentFillColorDefaultBrush}"
                          IsVisible="{Binding IsDashboardSelected}"
                          VerticalAlignment="Center"/>
                  <lucide:LucideIcon Grid.Column="1" Kind="LayoutDashboard" Size="18"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                     VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Dashboard" Margin="10,0,0,0"
                             IsVisible="{Binding IsPaneOpen}"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>

              <!-- Tunnel -->
              <Button Command="{Binding NavigateTunnelCommand}"
                      Classes="nav-item"
                      Classes.active="{Binding IsTunnelSelected}"
                      ToolTip.Tip="Tunnel (Ctrl+2)">
                <Grid ColumnDefinitions="Auto, Auto, *">
                  <Border Grid.Column="0"
                          Width="3" Height="16" CornerRadius="2" Margin="0,0,8,0"
                          Background="{DynamicResource AccentFillColorDefaultBrush}"
                          IsVisible="{Binding IsTunnelSelected}"
                          VerticalAlignment="Center"/>
                  <lucide:LucideIcon Grid.Column="1" Kind="Globe" Size="18" Foreground="#3498DB" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Tunnel" Margin="10,0,0,0"
                             IsVisible="{Binding IsPaneOpen}"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>

              <!-- Remote Control -->
              <Button Command="{Binding NavigateRemoteControlCommand}"
                      Classes="nav-item"
                      Classes.active="{Binding IsRemoteControlSelected}"
                      ToolTip.Tip="Remote Control (Ctrl+3)">
                <Grid ColumnDefinitions="Auto, Auto, *">
                  <Border Grid.Column="0"
                          Width="3" Height="16" CornerRadius="2" Margin="0,0,8,0"
                          Background="{DynamicResource AccentFillColorDefaultBrush}"
                          IsVisible="{Binding IsRemoteControlSelected}"
                          VerticalAlignment="Center"/>
                  <lucide:LucideIcon Grid.Column="1" Kind="Smartphone" Size="18" Foreground="#9B59B6" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Remote Control" Margin="10,0,0,0"
                             IsVisible="{Binding IsPaneOpen}"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>

              <!-- News -->
              <Button Command="{Binding NavigateNewsCommand}"
                      Classes="nav-item"
                      Classes.active="{Binding IsNewsSelected}"
                      ToolTip.Tip="News (Ctrl+7)">
                <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                  <Border Grid.Column="0"
                          Width="3" Height="16" CornerRadius="2" Margin="0,0,8,0"
                          Background="{DynamicResource AccentFillColorDefaultBrush}"
                          IsVisible="{Binding IsNewsSelected}"
                          VerticalAlignment="Center"/>
                  <lucide:LucideIcon Grid.Column="1" Kind="Megaphone" Size="18" Foreground="#E67E22" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="News" Margin="10,0,0,0"
                             IsVisible="{Binding IsPaneOpen}"
                             VerticalAlignment="Center"/>
                  <Border Grid.Column="3"
                          MinWidth="16" Height="16"
                          CornerRadius="8"
                          Background="#C42B1C"
                          Padding="4,0"
                          IsVisible="{Binding HasUnreadNews}"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding UnreadNewsCount}"
                               FontSize="9" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </Button>
            </StackPanel>

            <!-- Footer Navigation Items -->
            <StackPanel Grid.Row="2" Spacing="3">
              <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="6,4"/>

              <!-- Settings -->
              <Button Command="{Binding NavigateSettingsCommand}"
                      Classes="nav-item-footer"
                      Classes.active="{Binding IsSettingsSelected}"
                      ToolTip.Tip="Settings (Ctrl+5)">
                <Grid ColumnDefinitions="Auto, Auto, *">
                  <Border Grid.Column="0"
                          Width="3" Height="14" CornerRadius="2" Margin="0,0,8,0"
                          Background="{DynamicResource AccentFillColorDefaultBrush}"
                          IsVisible="{Binding IsSettingsSelected}"
                          VerticalAlignment="Center"/>
                  <lucide:LucideIcon Grid.Column="1" Kind="Settings" Size="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Settings" FontSize="13" Margin="10,0,0,0"
                             IsVisible="{Binding IsPaneOpen}"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>

              <!-- Runtimes -->
              <Button Command="{Binding NavigateRuntimesCommand}"
                      Classes="nav-item-footer"
                      Classes.active="{Binding IsRuntimesSelected}"
                      ToolTip.Tip="Runtimes (Ctrl+4)">
                <Grid ColumnDefinitions="Auto, Auto, *">
                  <Border Grid.Column="0"
                          Width="3" Height="14" CornerRadius="2" Margin="0,0,8,0"
                          Background="{DynamicResource AccentFillColorDefaultBrush}"
                          IsVisible="{Binding IsRuntimesSelected}"
                          VerticalAlignment="Center"/>
                  <lucide:LucideIcon Grid.Column="1" Kind="Download" Size="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Runtimes" FontSize="13" Margin="10,0,0,0"
                             IsVisible="{Binding IsPaneOpen}"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>

              <!-- About -->
              <Button Command="{Binding NavigateAboutCommand}"
                      Classes="nav-item-footer"
                      Classes.active="{Binding IsAboutSelected}"
                      ToolTip.Tip="About (Ctrl+6)">
                <Grid ColumnDefinitions="Auto, Auto, *">
                  <Border Grid.Column="0"
                          Width="3" Height="14" CornerRadius="2" Margin="0,0,8,0"
                          Background="{DynamicResource AccentFillColorDefaultBrush}"
                          IsVisible="{Binding IsAboutSelected}"
                          VerticalAlignment="Center"/>
                  <lucide:LucideIcon Grid.Column="1" Kind="Info" Size="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="About" FontSize="13" Margin="10,0,0,0"
                             IsVisible="{Binding IsPaneOpen}"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Main Window Client Content -->
        <Border Grid.Column="1"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0">
          <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
