<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PocketMC.App.ViewModels"
        xmlns:views="using:PocketMC.App.Views"
        xmlns:lucide="using:Lucide.Avalonia"
        x:Class="PocketMC.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PocketMC"
        TransparencyLevelHint="Mica, AcrylicBlur, Blur, None"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        MinWidth="1024" MinHeight="680" Width="1100" Height="740">

  <Window.Styles>
    <Style Selector="Button.nav-item">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.nav-item:pointerover">
      <Setter Property="Background" Value="#15FFFFFF"/>
    </Style>
    <Style Selector="Button.nav-item.active">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.nav-item-footer">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.nav-item-footer:pointerover">
      <Setter Property="Background" Value="#15FFFFFF"/>
    </Style>
    <Style Selector="Button.nav-item-footer.active">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Styles>

  <Grid x:Name="RootGrid">
    <!-- Blurred wallpaper fallback layer -->
    <Image x:Name="WallpaperBlurLayer"
           IsVisible="False"
           IsHitTestVisible="False"
           Stretch="UniformToFill"/>
    <Border x:Name="WallpaperTintOverlay"
            IsVisible="False"
            IsHitTestVisible="False"/>

    <!-- Subtle tinted backdrop layer for rich contrast -->
    <Border x:Name="BackdropTintLayer"
            Background="#D9121214"
            IsHitTestVisible="False"/>

    <!-- Root shell grid: Update banner, TitleBar, Client area -->
    <Grid RowDefinitions="Auto, 40, *">
      <!-- Update notification banner (collapsible) -->
      <Border Grid.Row="0"
              IsVisible="{Binding IsUpdateBannerVisible}"
              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,8">
        <Grid ColumnDefinitions="*, Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <ProgressBar Width="120" Height="6" Minimum="0" Maximum="100"
                         Value="{Binding UpdateDownloadPercent}"
                         Margin="0,0,10,0"
                         IsVisible="{Binding IsUpdateDownloading}"/>
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding UpdateStatusMessage}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       FontSize="13"
                       FontWeight="Medium"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Restart to update"
                    Background="{DynamicResource AccentPrimaryBrush}"
                    Foreground="White"
                    Padding="10,4"
                    CornerRadius="6"
                    Command="{Binding RestartAndApplyUpdateCommand}"
                    IsVisible="{Binding IsUpdateReadyToApply}"
                    Cursor="Hand"/>
            <Button Content="Dismiss"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6,4"
                    Command="{Binding DismissUpdateBannerCommand}"
                    Cursor="Hand"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Title bar drag region -->
      <Border Grid.Row="1"
              PointerPressed="TitleBar_OnPointerPressed"
              Background="Transparent"
              Height="40">
        <Grid Margin="{Binding TitleBarContentMargin, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
              ColumnDefinitions="Auto, Auto, *, Auto"
              VerticalAlignment="Center">

          <!-- Left: Back Button & App Brand / Breadcrumb -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0">
            <Button x:Name="BtnBack"
                    Command="{Binding NavigateBackCommand}"
                    IsVisible="{Binding CanNavigateBack}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4"
                    Cursor="Hand"
                    ToolTip.Tip="Navigate Back (Escape / Alt+Left)">
              <lucide:LucideIcon Kind="ArrowLeft" Size="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>

            <Image Source="avares://PocketMC.App/Assets/icon.png" Width="18" Height="18" VerticalAlignment="Center"/>
            <TextBlock Text="PocketMC" FontWeight="Bold" FontSize="14"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="/" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0"/>
            <TextBlock Text="{Binding CurrentBreadcrumb}" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Center: TitleBar Context (Server Name & Status Dot) -->
          <Border Grid.Column="1"
                  IsVisible="{Binding IsTitleBarContextVisible}"
                  Background="#18FFFFFF"
                  CornerRadius="4"
                  Height="24"
                  Padding="10,0"
                  Margin="16,0,0,0"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding TitleBarTitle}"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center"/>
              <TextBlock Text="  •  "
                         FontSize="12"
                         Foreground="{DynamicResource TextFillColorDisabledBrush}"
                         VerticalAlignment="Center"/>
              <Ellipse Width="7" Height="7" Fill="{Binding TitleBarStatusColor}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding TitleBarStatusText}"
                         FontSize="12" FontWeight="Medium"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- Right: Global Health Badge (System RAM) -->
          <Border Grid.Column="3"
                  IsVisible="{Binding IsGlobalHealthVisible}"
                  Background="#18FFFFFF"
                  CornerRadius="4"
                  Height="24"
                  Padding="10,0"
                  Margin="0,0,16,0"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding GlobalHealthStatusText}"
                       FontSize="11" FontWeight="Medium"
                       Foreground="{Binding GlobalHealthStatusColor}"
                       VerticalAlignment="Center"/>
          </Border>
        </Grid>
      </Border>

      <!-- Client Area with Left Sidebar Navigation -->
      <Grid Grid.Row="2" ColumnDefinitions="240, *">
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="#10FFFFFF"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,1,0"
                Padding="12,14">
          <Grid RowDefinitions="*, Auto">
            <!-- Main navigation buttons -->
            <StackPanel Grid.Row="0" Spacing="4">
              <!-- Dashboard -->
              <Button Command="{Binding NavigateDashboardCommand}"
                      Classes="nav-item"
                      Classes.active="{Binding IsDashboardSelected}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <lucide:LucideIcon Kind="LayoutDashboard" Size="18" Foreground="{DynamicResource AccentBrush}"/>
                  <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <!-- Tunnel -->
              <Button Command="{Binding NavigateTunnelCommand}"
                      Classes="nav-item"
                      Classes.active="{Binding IsTunnelSelected}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <lucide:LucideIcon Kind="Globe" Size="18" Foreground="#3498DB"/>
                  <TextBlock Text="Tunnel" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <!-- Remote Control -->
              <Button Command="{Binding NavigateRemoteControlCommand}"
                      Classes="nav-item"
                      Classes.active="{Binding IsRemoteControlSelected}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <lucide:LucideIcon Kind="Smartphone" Size="18" Foreground="#9B59B6"/>
                  <TextBlock Text="Remote Control" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <!-- News -->
              <Button Command="{Binding NavigateNewsCommand}"
                      Classes="nav-item"
                      Classes.active="{Binding IsNewsSelected}">
                <Grid ColumnDefinitions="Auto, *, Auto">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <lucide:LucideIcon Kind="Megaphone" Size="18" Foreground="#E67E22"/>
                    <TextBlock Text="News" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Border Grid.Column="2"
                          MinWidth="16" Height="16"
                          CornerRadius="8"
                          Background="#C42B1C"
                          Padding="4,0"
                          IsVisible="{Binding UnreadNewsCount}"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding UnreadNewsCount}"
                               FontSize="9" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </Button>
            </StackPanel>

            <!-- Bottom footer navigation -->
            <StackPanel Grid.Row="1" Spacing="4">
              <!-- Settings -->
              <Button Command="{Binding NavigateSettingsCommand}"
                      Classes="nav-item-footer"
                      Classes.active="{Binding IsSettingsSelected}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <lucide:LucideIcon Kind="Settings" Size="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <!-- Runtimes -->
              <Button Command="{Binding NavigateRuntimesCommand}"
                      Classes="nav-item-footer"
                      Classes.active="{Binding IsRuntimesSelected}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <lucide:LucideIcon Kind="Download" Size="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBlock Text="Runtimes" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <!-- About -->
              <Button Command="{Binding NavigateAboutCommand}"
                      Classes="nav-item-footer"
                      Classes.active="{Binding IsAboutSelected}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <lucide:LucideIcon Kind="Info" Size="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBlock Text="About" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Main Window Client Content -->
        <Border Grid.Column="1"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0">
          <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
