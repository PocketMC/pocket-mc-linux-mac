<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PocketMC.App.ViewModels"
             xmlns:infra="using:PocketMC.Infrastructure.Services"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="PocketMC.App.Views.MarketplacePage"
             x:DataType="vm:MarketplaceViewModel"
             Background="Transparent">

  <Grid RowDefinitions="Auto, *">
    <!-- HEADER BAR -->
    <Border Grid.Row="0" Classes="card" CornerRadius="0" BorderThickness="0,0,0,1" Padding="18,12">
      <Grid ColumnDefinitions="Auto, *, Auto">
        <Button Grid.Column="0" Command="{Binding NavigateBackCommand}" Classes="subtle" Padding="8,6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <lucide:LucideIcon Kind="ArrowLeft" Size="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Back" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Medium"/>
          </StackPanel>
        </Button>

        <TextBlock Grid.Column="1" Text="{Binding PageTitle}"
                   FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <ProgressBar IsIndeterminate="True" Width="90" Height="4"
                       IsVisible="{Binding IsSearching}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                     FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- CONTENT -->
    <Grid Grid.Row="1" ColumnDefinitions="*, 320" Margin="20,16">
      <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" Margin="0,0,16,0">
        <!-- Filter Controls -->
        <Border Grid.Row="0" Classes="card" Padding="14,12" Margin="0,0,0,14">
          <Grid ColumnDefinitions="*, 10, Auto, 10, Auto, 10, Auto, 10, Auto">
            <TextBox Grid.Column="0" Text="{Binding SearchQuery, Mode=TwoWay}"
                     Watermark="{Binding SearchPlaceholder}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
              </TextBox.KeyBindings>
            </TextBox>

            <ComboBox Grid.Column="2" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" Width="128"/>
            <ComboBox Grid.Column="4" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType, Mode=TwoWay}" Width="108"/>
            <ComboBox Grid.Column="6" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                      IsEnabled="{Binding CanSelectSort}" Width="128"/>

            <Button Grid.Column="8" Command="{Binding SearchCommand}" Classes="primary" Padding="14,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <lucide:LucideIcon Kind="Search" Size="15" VerticalAlignment="Center"/>
                <TextBlock Text="Search" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Search Results -->
        <Border Grid.Row="1" Classes="card" Padding="14">
          <Grid RowDefinitions="Auto, *">
            <TextBlock Grid.Row="0" Text="Catalog Results" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10"/>

            <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchResultItemViewModel">
                  <Grid ColumnDefinitions="Auto, *, Auto" Margin="4,8">
                    <Border Grid.Column="0" Width="48" Height="48"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                      <Panel>
                        <TextBlock Text="{Binding InitialLetter}" Foreground="{DynamicResource AccentPrimaryBrush}"
                                   FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                        <Image Source="{Binding IconBitmap}" Stretch="UniformToFill"
                               IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                      </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Hit.Title}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                      <TextBlock Text="{Binding Hit.Description}" FontSize="12"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="12,0,0,0">
                      <TextBlock Text="{Binding Hit.Downloads, StringFormat='{}{0:N0} DLs'}" FontSize="11"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                      <Panel>
                        <Button Command="{Binding $parent[UserControl].((vm:MarketplaceViewModel)DataContext).InstallAddonCommand}"
                                CommandParameter="{Binding}"
                                Classes="primary" Padding="12,6"
                                IsVisible="{Binding !IsInstalled}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <lucide:LucideIcon Kind="Download" Size="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Install" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>

                        <Button Command="{Binding $parent[UserControl].((vm:MarketplaceViewModel)DataContext).InstallAddonCommand}"
                                CommandParameter="{Binding}"
                                Classes="secondary" Padding="12,6"
                                IsVisible="{Binding IsInstalled}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <lucide:LucideIcon Kind="RefreshCw" Size="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Reinstall" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                      </Panel>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <!-- Download Progress -->
        <Border Grid.Row="2" Classes="card" Padding="14" Margin="0,12,0,0" IsVisible="{Binding IsDownloading}">
          <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}"
                       FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Bold"/>
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="6" Margin="0,8,0,0"/>
          </Grid>
        </Border>
      </Grid>

      <!-- RIGHT SIDE: Installed Addons -->
      <Border Grid.Column="1" Classes="card" Padding="14">
        <Grid RowDefinitions="Auto, *">
          <TextBlock Grid.Row="0" Text="Installed Addons" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10"/>

          <ListBox Grid.Row="1" ItemsSource="{Binding InstalledAddons}" SelectedItem="{Binding SelectedInstalledAddon}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="infra:AddonManifestEntry">
                <Grid ColumnDefinitions="*, Auto" Margin="4,8">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{Binding ProjectTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                    <TextBlock Text="{Binding DisplayName, StringFormat='Version: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                  </StackPanel>

                  <Button Grid.Column="1"
                          Command="{Binding $parent[UserControl].((vm:MarketplaceViewModel)DataContext).UninstallAddonCommand}"
                          CommandParameter="{Binding}"
                          Classes="subtle" Padding="6" VerticalAlignment="Center">
                    <lucide:LucideIcon Kind="Trash2" Size="15" Foreground="#EF4444"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
