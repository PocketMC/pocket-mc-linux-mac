<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PocketMC.App.ViewModels"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="PocketMC.App.Views.Marketplace.MapBrowserPage"
             x:DataType="vm:MarketplaceViewModel"
             Background="Transparent">

  <Grid Margin="28,20,28,24" RowDefinitions="Auto, Auto, *">
    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,18">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
        <Button Classes="secondary"
                Command="{Binding NavigateBackCommand}"
                MinWidth="88"
                Padding="12,7">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="ArrowLeft" Size="15"/>
            <TextBlock Text="Back" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <TextBlock Text="World Maps Browser"
                   FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <Button Grid.Column="2"
              Classes="secondary"
              Command="{Binding OpenWebMapsCommand}"
              ToolTip.Tip="Open minecraftmaps.com"
              Padding="12,7">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <lucide:LucideIcon Kind="Globe" Size="15"/>
          <TextBlock Text="Browse More on Web" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- Search and Filter Card -->
    <Border Grid.Row="1" Classes="card" Padding="14,12" Margin="0,0,0,16">
      <WrapPanel VerticalAlignment="Center">
        <TextBox x:Name="TxtSearch"
                 Text="{Binding SearchQuery, Mode=TwoWay}"
                 Watermark="Search maps..."
                 Width="250"
                 Margin="0,4,14,4">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
          </TextBox.KeyBindings>
        </TextBox>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,14,4" VerticalAlignment="Center">
          <TextBlock Text="Source:" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <ComboBox ItemsSource="{Binding Providers}"
                    SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                    IsEnabled="False"
                    Width="126"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,14,4" VerticalAlignment="Center">
          <TextBlock Text="Sort by:" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <ComboBox ItemsSource="{Binding MapSortOptions}"
                    SelectedItem="{Binding SelectedMapSort, Mode=TwoWay}"
                    Width="152"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,14,4" VerticalAlignment="Center">
          <TextBlock Text="Category:" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <ComboBox ItemsSource="{Binding MapCategories}"
                    SelectedItem="{Binding SelectedMapCategory, Mode=TwoWay}"
                    Width="156"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,12,4" VerticalAlignment="Center">
          <lucide:LucideIcon Kind="Info" Size="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding MinecraftVersionBadgeText}" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <Button Command="{Binding SearchCommand}" Classes="primary" Padding="14,7" Margin="0,4,0,4">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="Search" Size="14"/>
            <TextBlock Text="Search" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </WrapPanel>
    </Border>

    <!-- Results -->
    <Grid Grid.Row="2">
      <!-- Skeleton Loader -->
      <ScrollViewer VerticalScrollBarVisibility="Disabled" IsVisible="{Binding IsSearching}">
        <StackPanel Spacing="12">
          <Border Classes="skeleton-card" Padding="14">
            <Grid ColumnDefinitions="64, *, Auto">
              <Border Grid.Column="0" Classes="skeleton-element" Width="64" Height="64" CornerRadius="8"/>
              <StackPanel Grid.Column="1" Margin="16,0" Spacing="8" VerticalAlignment="Center">
                <Border Classes="skeleton-element" Height="16" Width="190" HorizontalAlignment="Left"/>
                <Border Classes="skeleton-element" Height="12" Width="320" HorizontalAlignment="Left"/>
                <Border Classes="skeleton-element" Height="10" Width="90" HorizontalAlignment="Left"/>
              </StackPanel>
              <Border Grid.Column="2" Classes="skeleton-element" Width="92" Height="34" CornerRadius="6" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Classes="skeleton-card" Padding="14">
            <Grid ColumnDefinitions="64, *, Auto">
              <Border Grid.Column="0" Classes="skeleton-element" Width="64" Height="64" CornerRadius="8"/>
              <StackPanel Grid.Column="1" Margin="16,0" Spacing="8" VerticalAlignment="Center">
                <Border Classes="skeleton-element" Height="16" Width="160" HorizontalAlignment="Left"/>
                <Border Classes="skeleton-element" Height="12" Width="280" HorizontalAlignment="Left"/>
                <Border Classes="skeleton-element" Height="10" Width="80" HorizontalAlignment="Left"/>
              </StackPanel>
              <Border Grid.Column="2" Classes="skeleton-element" Width="92" Height="34" CornerRadius="6" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" IsVisible="{Binding !IsSearching}">
        <StackPanel Spacing="12">
          <ItemsControl ItemsSource="{Binding SearchResults}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SearchResultItemViewModel">
                <Border Classes="card" Padding="14" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="64, *, Auto">
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="6" ClipToBounds="True"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                      <Panel>
                        <Image Source="{Binding IconBitmap}" Stretch="UniformToFill"
                               IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Text="{Binding InitialLetter}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                      </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Hit.Title}" FontSize="15" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                      <TextBlock Text="{Binding Hit.Description}" FontSize="12"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 TextWrapping="Wrap" MaxLines="2"/>
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                        <lucide:LucideIcon Kind="Download" Size="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Hit.Downloads, StringFormat='{}{0:N0} downloads'}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Width="96" Height="34"
                            Classes="primary"
                            Command="{Binding $parent[UserControl].((vm:MarketplaceViewModel)DataContext).InstallAddonCommand}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding !IsInstalling}"
                            VerticalAlignment="Center">
                      <TextBlock Text="Import" HorizontalAlignment="Center"/>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="Load More Maps"
                  Command="{Binding LoadMoreCommand}"
                  IsVisible="{Binding HasMoreResults}"
                  Classes="secondary"
                  HorizontalAlignment="Center"
                  Padding="18,8"/>
        </StackPanel>
      </ScrollViewer>

      <!-- Empty State -->
      <StackPanel IsVisible="{Binding IsEmptyResults}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Spacing="10" MaxWidth="420" Margin="0,0,0,36">
        <Border Width="76" Height="76" CornerRadius="38"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                HorizontalAlignment="Center">
          <lucide:LucideIcon Kind="Search" Size="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="No results found" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding EmptyStateDetail}" FontSize="13"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
        <Button Content="Reset Filters"
                Command="{Binding ResetFiltersCommand}"
                Classes="secondary"
                HorizontalAlignment="Center"
                Padding="16,7"/>
      </StackPanel>

      <!-- CurseForge Key Required -->
      <StackPanel IsVisible="{Binding ShowCurseForgeKeyPanel}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Spacing="12" MaxWidth="460" Margin="0,0,0,32">
        <Border Width="76" Height="76" CornerRadius="38"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                HorizontalAlignment="Center">
          <lucide:LucideIcon Kind="Key" Size="32" Foreground="#F59E0B"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding CurseForgeKeyTitle}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding CurseForgeKeyDetail}" FontSize="13"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
        <Button Content="Configure API Key"
                Command="{Binding ConfigureCurseForgeKeyCommand}"
                Classes="primary"
                HorizontalAlignment="Center"
                Padding="18,8"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
