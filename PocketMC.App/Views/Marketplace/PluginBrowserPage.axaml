<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PocketMC.App.ViewModels"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="PocketMC.App.Views.Marketplace.PluginBrowserPage"
             x:DataType="vm:MarketplaceViewModel"
             Background="{DynamicResource WindowBackgroundBrush}">

    <Grid RowDefinitions="Auto, *">
        <!-- HEADER BAR -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" Padding="16,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Button Grid.Column="0" Command="{Binding NavigateBackCommand}" 
                        Background="Transparent" BorderThickness="0" Padding="8" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <lucide:LucideIcon Kind="ArrowLeft" Size="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Back" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
                
                <TextBlock Grid.Column="1" Text="Plugin &amp; Mod Marketplace" 
                           FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="4" 
                                 IsVisible="{Binding IsSearching}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 350" Margin="16">
            <!-- LEFT: Search & Results -->
            <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" Margin="0,0,16,0">
                <!-- Search Controls -->
                <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                    <Grid ColumnDefinitions="*, 12, Auto, 12, Auto">
                        <TextBox Grid.Column="0" Text="{Binding SearchQuery}" Watermark="Search for plugins and mods..." 
                                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>

                        <ComboBox Grid.Column="2" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Width="130"/>

                        <Button Grid.Column="4" Command="{Binding SearchCommand}" Background="#1E90FF" Foreground="White" CornerRadius="8" Padding="16,8" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <lucide:LucideIcon Kind="Search" Size="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Search" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Search Results List -->
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="Catalog Results" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        
                        <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SearchResultItemViewModel">
                                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="4,8">
                                        <!-- Icon -->
                                        <Border Grid.Column="0" Width="40" Height="40" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                                            <Panel>
                                                <Image Source="{Binding IconBitmap}" Width="40" Height="40" Stretch="UniformToFill" IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                <TextBlock Text="{Binding InitialLetter}" FontSize="18" FontWeight="Bold" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                                            </Panel>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding Hit.Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Hit.Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Panel>
                                                <Button Command="{ReflectionBinding $parent[UserControl].DataContext.InstallAddonCommand}" 
                                                        CommandParameter="{Binding}"
                                                        Background="#1E90FF" Foreground="White" CornerRadius="6" Padding="10,6"
                                                        IsVisible="{Binding !IsInstalled}" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <lucide:LucideIcon Kind="Download" Size="14" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Install" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{ReflectionBinding $parent[UserControl].DataContext.InstallAddonCommand}" 
                                                        CommandParameter="{Binding}"
                                                        Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextSecondaryBrush}" CornerRadius="6" Padding="10,6"
                                                        IsVisible="{Binding IsInstalled}" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <lucide:LucideIcon Kind="RefreshCw" Size="14" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Reinstall" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Panel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Download Progress -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16" Margin="0,16,0,0" IsVisible="{Binding IsDownloading}">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" FontSize="12" Foreground="#1E90FF" FontWeight="Bold"/>
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="8" Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT: Installed Addons -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="Installed Addons" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding InstalledAddons}" SelectedItem="{Binding SelectedInstalledAddon}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, Auto" Margin="4,8">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding ProjectTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="{Binding DisplayName, StringFormat='Version: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Command="{ReflectionBinding $parent[UserControl].DataContext.UninstallAddonCommand}" 
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Foreground="#E74C3C" VerticalAlignment="Center" Cursor="Hand">
                                        <lucide:LucideIcon Kind="Trash" Size="16"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
