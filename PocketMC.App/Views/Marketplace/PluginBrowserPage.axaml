<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PocketMC.App.ViewModels"
             xmlns:infra="using:PocketMC.Infrastructure.Services"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="PocketMC.App.Views.Marketplace.PluginBrowserPage"
             x:DataType="vm:MarketplaceViewModel"
             Background="Transparent">

  <Grid Margin="28,20,28,24" RowDefinitions="Auto, Auto, *">
    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,18">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
        <Button Classes="secondary"
                Command="{Binding NavigateBackCommand}"
                MinWidth="88"
                Padding="12,7">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="ArrowLeft" Size="15"/>
            <TextBlock Text="Back" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <TextBlock Text="{Binding PageTitle}"
                   FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusText}"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   VerticalAlignment="Center"
                   MaxWidth="260"
                   TextTrimming="CharacterEllipsis"/>
        <Button Classes="secondary"
                Command="{Binding ImportLocalModpackCommand}"
                IsVisible="{Binding IsModpackMode}"
                Padding="12,7">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="PackagePlus" Size="15"/>
            <TextBlock Text="Local Import (.zip, .mrpack)" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Search and Filter Card -->
    <Border Grid.Row="1" Classes="card" Padding="14,12" Margin="0,0,0,16">
      <WrapPanel VerticalAlignment="Center">
        <TextBox x:Name="TxtSearch"
                 Text="{Binding SearchQuery, Mode=TwoWay}"
                 Watermark="{Binding SearchPlaceholder}"
                 Width="250"
                 Margin="0,4,14,4">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
          </TextBox.KeyBindings>
        </TextBox>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,14,4" VerticalAlignment="Center">
          <TextBlock Text="Source:" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <ComboBox ItemsSource="{Binding Providers}"
                    SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                    Width="128"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,14,4" VerticalAlignment="Center"
                    IsVisible="{Binding ShowStandardFilters}">
          <TextBlock Text="Type:" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <ComboBox ItemsSource="{Binding Types}"
                    SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                    Width="112"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,14,4" VerticalAlignment="Center">
          <TextBlock Text="Sort By:" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <ComboBox ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                    IsEnabled="{Binding CanSelectSort}"
                    Width="136"/>
        </StackPanel>

        <!-- Modpack Mode Filters -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,14,4" VerticalAlignment="Center"
                    IsVisible="{Binding IsModpackMode}">
          <TextBlock Text="Loader:" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <ComboBox ItemsSource="{Binding ModpackLoaders}"
                    SelectedItem="{Binding SelectedModpackLoader, Mode=TwoWay}"
                    Width="116"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,14,4" VerticalAlignment="Center"
                    IsVisible="{Binding IsModpackMode}">
          <TextBlock Text="Version:" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <ComboBox ItemsSource="{Binding ModpackMcVersions}"
                    SelectedItem="{Binding SelectedModpackMcVersion, Mode=TwoWay}"
                    Width="116"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,12,4" VerticalAlignment="Center"
                    IsVisible="{Binding ShowMcVersionBadge}">
          <lucide:LucideIcon Kind="Info" Size="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding MinecraftVersionBadgeText}" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <Button Command="{Binding SearchCommand}" Classes="primary" Padding="14,7" Margin="0,4,0,4">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="Search" Size="14"/>
            <TextBlock Text="Search" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </WrapPanel>
    </Border>

    <!-- Content Area -->
    <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
      <!-- Results & Empty/Key States -->
      <Grid Grid.Column="0">
        <!-- Skeleton Loader -->
        <ScrollViewer VerticalScrollBarVisibility="Disabled" IsVisible="{Binding IsSearching}">
          <StackPanel Spacing="12">
            <Border Classes="skeleton-card" Padding="14">
              <Grid ColumnDefinitions="64, *, Auto">
                <Border Grid.Column="0" Classes="skeleton-element" Width="64" Height="64" CornerRadius="8"/>
                <StackPanel Grid.Column="1" Margin="16,0" Spacing="8" VerticalAlignment="Center">
                  <Border Classes="skeleton-element" Height="16" Width="190" HorizontalAlignment="Left"/>
                  <Border Classes="skeleton-element" Height="12" Width="320" HorizontalAlignment="Left"/>
                  <Border Classes="skeleton-element" Height="10" Width="90" HorizontalAlignment="Left"/>
                </StackPanel>
                <Border Grid.Column="2" Classes="skeleton-element" Width="92" Height="34" CornerRadius="6" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border Classes="skeleton-card" Padding="14">
              <Grid ColumnDefinitions="64, *, Auto">
                <Border Grid.Column="0" Classes="skeleton-element" Width="64" Height="64" CornerRadius="8"/>
                <StackPanel Grid.Column="1" Margin="16,0" Spacing="8" VerticalAlignment="Center">
                  <Border Classes="skeleton-element" Height="16" Width="160" HorizontalAlignment="Left"/>
                  <Border Classes="skeleton-element" Height="12" Width="280" HorizontalAlignment="Left"/>
                  <Border Classes="skeleton-element" Height="10" Width="80" HorizontalAlignment="Left"/>
                </StackPanel>
                <Border Grid.Column="2" Classes="skeleton-element" Width="92" Height="34" CornerRadius="6" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Catalog List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="0,0,12,0"
                      IsVisible="{Binding !IsSearching}">
          <StackPanel Spacing="12">
            <ItemsControl ItemsSource="{Binding SearchResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchResultItemViewModel">
                  <Border Classes="card" Padding="14" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="64, *, Auto">
                      <!-- 64x64 Icon -->
                      <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8" ClipToBounds="True"
                              Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Top">
                        <Panel>
                          <Image Source="{Binding IconBitmap}" Stretch="UniformToFill"
                                 IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                          <TextBlock Text="{Binding InitialLetter}" FontSize="22" FontWeight="Bold"
                                     Foreground="{DynamicResource AccentPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                        </Panel>
                      </Border>

                      <!-- Text Details -->
                      <StackPanel Grid.Column="1" Margin="16,0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Hit.Title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding Hit.Description}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="2"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                          <lucide:LucideIcon Kind="Download" Size="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Hit.Downloads, StringFormat='{}{0:N0} downloads'}" FontSize="11"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </StackPanel>

                      <!-- Install/Reinstall Button -->
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                        <Button Width="102" Height="34"
                                Command="{Binding $parent[UserControl].((vm:MarketplaceViewModel)DataContext).InstallAddonCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding !IsInstalling}"
                                Classes="primary"
                                IsVisible="{Binding !IsInstalled}">
                          <TextBlock Text="{Binding ActionButtonText}" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Width="102" Height="34"
                                Command="{Binding $parent[UserControl].((vm:MarketplaceViewModel)DataContext).InstallAddonCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding !IsInstalling}"
                                Classes="secondary"
                                IsVisible="{Binding IsInstalled}">
                          <TextBlock Text="Reinstall" HorizontalAlignment="Center"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Load More Results"
                    Command="{Binding LoadMoreCommand}"
                    IsVisible="{Binding HasMoreResults}"
                    Classes="secondary"
                    HorizontalAlignment="Center"
                    Padding="18,8"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Empty State Placeholder -->
        <StackPanel IsVisible="{Binding IsEmptyResults}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="10" MaxWidth="420" Margin="0,0,0,36">
          <Border Width="76" Height="76" CornerRadius="38"
                  Background="{DynamicResource ControlFillColorSecondaryBrush}"
                  HorizontalAlignment="Center">
            <lucide:LucideIcon Kind="Search" Size="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="No results found" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding EmptyStateDetail}" FontSize="13"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
          <Button Content="Reset Filters"
                  Command="{Binding ResetFiltersCommand}"
                  Classes="secondary"
                  HorizontalAlignment="Center"
                  Padding="16,7"/>
        </StackPanel>

        <!-- CurseForge API Key Required Card -->
        <StackPanel IsVisible="{Binding ShowCurseForgeKeyPanel}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="12" MaxWidth="460" Margin="0,0,0,32">
          <Border Width="76" Height="76" CornerRadius="38"
                  Background="{DynamicResource ControlFillColorSecondaryBrush}"
                  HorizontalAlignment="Center">
            <lucide:LucideIcon Kind="Key" Size="32" Foreground="#F59E0B"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding CurseForgeKeyTitle}" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding CurseForgeKeyDetail}" FontSize="13"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Content="Configure API Key"
                    Command="{Binding ConfigureCurseForgeKeyCommand}"
                    Classes="primary"
                    Padding="16,8"/>
            <Button Content="Switch to Modrinth"
                    Command="{Binding SwitchToModrinthCommand}"
                    Classes="secondary"
                    Padding="16,8"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Right Sidebar: Installed Addons (Hidden during modpack browse) -->
      <Border Grid.Column="1" Width="300" Margin="14,0,0,0" Classes="card" Padding="14"
              IsVisible="{Binding !IsModpackMode}">
        <Grid RowDefinitions="Auto, *">
          <TextBlock Grid.Row="0" Text="Installed Addons" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding InstalledAddons}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="infra:AddonManifestEntry">
                <Grid ColumnDefinitions="*, Auto" Margin="2,6">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding ProjectTitle}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding FileName}" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button Grid.Column="1"
                          Command="{Binding $parent[UserControl].((vm:MarketplaceViewModel)DataContext).UninstallAddonCommand}"
                          CommandParameter="{Binding}"
                          Classes="subtle"
                          Padding="6"
                          ToolTip.Tip="Uninstall addon">
                    <lucide:LucideIcon Kind="Trash2" Size="14" Foreground="#EF4444"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
