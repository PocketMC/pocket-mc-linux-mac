<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PocketMC.App.ViewModels"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="PocketMC.App.Views.AiDiagnosticPage"
             x:DataType="vm:AiDiagnosticViewModel"
             Background="Transparent">

  <Grid RowDefinitions="Auto, *">
    
    <!-- HEADER BAR -->
    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16,12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto, *, Auto">
        <Button Grid.Column="0" Command="{Binding GoBackCommand}" 
                Background="Transparent" BorderThickness="0" Padding="8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="ArrowLeft" Size="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="Back to Console" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1" Text="AI Crash &amp; Log Diagnostics" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding SelectedInstance.Name, StringFormat='Instance: {0}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- BODY -->
    <Grid Grid.Row="1" ColumnDefinitions="260, *" Margin="16">

      <!-- LEFT PANEL: AI Settings -->
      <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" Margin="0,0,12,0" VerticalAlignment="Top">
        <StackPanel Spacing="14">
          <TextBlock Text="AI Settings" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
          
          <!-- Provider Dropdown -->
          <StackPanel Spacing="4">
            <TextBlock Text="Select AI Provider" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" 
                      HorizontalAlignment="Stretch" Height="36"/>
          </StackPanel>

          <!-- Model -->
          <StackPanel Spacing="4">
            <TextBlock Text="Model Selection" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <AutoCompleteBox ItemsSource="{Binding Models}" Text="{Binding CustomModelName, Mode=TwoWay}"
                             FilterMode="Contains" HorizontalAlignment="Stretch" Height="36"/>
          </StackPanel>

          <!-- API Key -->
          <StackPanel Spacing="4">
            <TextBlock Text="API Key (Optional Override)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBox Text="{Binding CustomApiKey}" PasswordChar="●"
                     Watermark="Enter API key..." Height="36"/>
          </StackPanel>
          
          <!-- Privacy notice -->
          <Border Background="#1A10B981" BorderBrush="#4010B981" BorderThickness="1" CornerRadius="8" Padding="10">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <lucide:LucideIcon Kind="ShieldCheck" Size="14" Foreground="#27ae60"/>
                <TextBlock Text="Privacy Guard Active" FontSize="11" FontWeight="SemiBold" Foreground="#2ecc71"/>
              </StackPanel>
              <TextBlock Text="Before log transmission, all IPv4/IPv6 addresses and local system folders are automatically redacted. Player usernames remain intact." 
                         FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Analyze Button -->
          <Button Command="{Binding AnalyzeCommand}" HorizontalAlignment="Stretch" 
                  Background="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold"
                  Padding="0,12" HorizontalContentAlignment="Center" CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <lucide:LucideIcon Kind="Sparkles" Size="16" Foreground="White"/>
              <TextBlock Text="Analyze Server Log" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- RIGHT PANEL: Report View -->
      <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto, *">
          <TextBlock Grid.Row="0" Text="Troubleshooting Diagnosis" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>
          
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Panel>
              <!-- State 1: Blank state -->
              <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center" 
                          IsVisible="{Binding ShowInitialState}">
                <lucide:LucideIcon Kind="Sparkles" Size="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a provider and click 'Analyze Server Log' to query diagnostic advice." 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" TextAlignment="Center"/>
              </StackPanel>

              <!-- State 2: Loading -->
              <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding IsLoading}">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" HorizontalAlignment="Center"/>
                <TextBlock Text="Consulting AI expert (Scrubbing logs, analyzing stack traces...)" 
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="13" FontWeight="Medium" TextAlignment="Center"/>
              </StackPanel>

              <!-- State 3: Error -->
              <Border Background="#1AE74C3C" BorderBrush="#66E74C3C" BorderThickness="1" CornerRadius="8" Padding="16" VerticalAlignment="Top"
                      IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <lucide:LucideIcon Kind="ShieldAlert" Size="18" Foreground="#e74c3c" VerticalAlignment="Center"/>
                    <TextBlock Text="Analysis Failed" FontWeight="Bold" Foreground="#e74c3c" VerticalAlignment="Center" FontSize="14"/>
                  </StackPanel>
                  <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <!-- State 4: Diagnosis rendered markdown -->
              <ContentControl x:Name="MarkdownHost"
                              IsVisible="{Binding HasAnalysisResult}"
                              VerticalAlignment="Top"/>
            </Panel>
          </ScrollViewer>
        </Grid>
      </Border>
      
    </Grid>
  </Grid>

</UserControl>
