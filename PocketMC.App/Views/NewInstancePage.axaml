<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PocketMC.App.ViewModels"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="PocketMC.App.Views.NewInstancePage"
             x:DataType="vm:NewInstanceViewModel">

  <Grid RowDefinitions="Auto, *, Auto">

    <!-- Top Header & 1-Click Presets Bar -->
    <Border Grid.Row="0" Padding="28,20,28,14" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Command="{Binding CancelCommand}" Classes="secondary" Padding="10,7" ToolTip.Tip="Back (Esc)">
            <lucide:LucideIcon Kind="ArrowLeft" Size="16"/>
          </Button>
          <StackPanel>
            <TextBlock Text="Create a New Instance" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Choose a 1-click template preset or configure server software, ports, and world settings." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding BrowseModpacksCommand}" Classes="secondary" Padding="12,7">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="Globe" Size="14"/>
              <TextBlock Text="Browse Modpacks"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding ImportModpackCommand}" Classes="secondary" Padding="12,7">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="PackagePlus" Size="14"/>
              <TextBlock Text="Import Modpack (.mrpack / .zip)"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding ImportInstanceCommand}" Classes="secondary" Padding="12,7">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="ArchiveRestore" Size="14"/>
              <TextBlock Text="Import Archive"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Presets Wrap Bar -->
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
          <TextBlock Text="1-Click Presets:" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,6"/>
          <Button Command="{Binding ApplyPresetVanillaJavaCommand}" Content="Vanilla Java" Classes="secondary" Padding="10,5" Margin="0,0,6,6"/>
          <Button Command="{Binding ApplyPresetCrossplayGeyserCommand}" Content="Java + Geyser Crossplay" Classes="secondary" Padding="10,5" Margin="0,0,6,6"/>
          <Button Command="{Binding ApplyPresetBedrockCommand}" Content="Bedrock Dedicated" Classes="secondary" Padding="10,5" Margin="0,0,6,6"/>
          <Button Command="{Binding ApplyPresetPumpkinCommand}" Content="Pumpkin (Fast Native)" Classes="secondary" Padding="10,5" Margin="0,0,6,6"/>
          <Button Command="{Binding ApplyPresetPocketMineCommand}" Content="PocketMine PHP" Classes="secondary" Padding="10,5" Margin="0,0,6,6"/>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Scrollable Form Columns -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,20,28,20" Spacing="16">

        <!-- Inline ErrorCallout Banner matching Windows -->
        <Border IsVisible="{Binding HasError}"
                Background="#2B1A1A" BorderBrush="#F38BA8" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
          <Grid ColumnDefinitions="Auto, *, Auto">
            <lucide:LucideIcon Grid.Column="0" Kind="TriangleAlert" Size="18" Foreground="#F38BA8" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="#F38BA8" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Command="{Binding DismissErrorCommand}" Classes="subtle" Padding="6,4">
              <lucide:LucideIcon Kind="X" Size="14" Foreground="#F38BA8"/>
            </Button>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*, 18, *">

          <!-- Left Column: Server Identity, Software, Loader & Pumpkin Ports -->
          <Border Grid.Column="0" Classes="card" Padding="20" VerticalAlignment="Top">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <lucide:LucideIcon Kind="Server" Size="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Server Identity &amp; Software" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Server Name" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="my-survival-server"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Description / MOTD" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding Description, Mode=TwoWay}" Watermark="A Minecraft server powered by PocketMC"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Server Software / Engine" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding EngineTypes}" SelectedItem="{Binding SelectedEngine}" HorizontalAlignment="Stretch"/>
              </StackPanel>

              <!-- Version Row + Refresh Button -->
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*, Auto">
                  <TextBlock Grid.Column="0" Text="Minecraft / Software Version" FontSize="12" FontWeight="Medium"
                             Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Command="{Binding RefreshVersionsCommand}" Classes="subtle"
                          Padding="6,2" ToolTip.Tip="Refresh Version Catalog"
                          IsEnabled="{Binding !IsLoadingVersions}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <lucide:LucideIcon Kind="RefreshCw" Size="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock Text="Refresh" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                  </Button>
                </Grid>

                <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                          HorizontalAlignment="Stretch" IsEnabled="{Binding !IsLoadingVersions}"/>

                <TextBlock Text="{Binding RefreshVersionsStatus}" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           IsVisible="{Binding RefreshVersionsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <CheckBox IsChecked="{Binding ShowSnapshots, Mode=TwoWay}" Content="Include Snapshots / Pre-releases / Previews" FontSize="12"/>
              </StackPanel>

              <!-- Mod Loader Version Panel (Fabric / Forge / NeoForge) -->
              <StackPanel Spacing="4" IsVisible="{Binding IsLoaderVersionPanelVisible}">
                <TextBlock Text="Loader Version" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding SelectedLoaderVersion}"
                          HorizontalAlignment="Stretch" IsEnabled="{Binding !IsLoadingLoaderVersions}"/>
                <TextBlock Text="Fetching available loader builds..." FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           IsVisible="{Binding IsLoadingLoaderVersions}"/>
              </StackPanel>

              <!-- Geyser Crossplay (Java only) -->
              <Border Classes="card-secondary" IsVisible="{Binding IsJavaEngine}" Padding="12">
                <StackPanel Spacing="6">
                  <CheckBox IsChecked="{Binding EnableGeyser, Mode=TwoWay}" FontWeight="SemiBold"
                            Content="Enable Geyser + Floodgate (Bedrock Crossplay)"/>
                  <TextBlock Text="Allows Xbox, PlayStation, Switch, iOS, and Android players to join Paper/Fabric/Forge servers."
                             FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <!-- Pumpkin Dual-Protocol Panel -->
              <Border Classes="card-secondary" IsVisible="{Binding ShowPumpkinNetworkPanel}" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="Pumpkin Listeners (Java TCP + Bedrock UDP)" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <Grid ColumnDefinitions="*, 10, *">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <CheckBox IsChecked="{Binding PumpkinJavaEnabled, Mode=TwoWay}" Content="Java Listener" FontSize="12"/>
                      <TextBox Text="{Binding ServerPort, Mode=TwoWay}" Watermark="25565"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <CheckBox IsChecked="{Binding PumpkinBedrockEnabled, Mode=TwoWay}" Content="Bedrock (NetherNet)" FontSize="12"/>
                      <TextBox Text="{Binding PumpkinBedrockPort, Mode=TwoWay}" Watermark="19132"/>
                    </StackPanel>
                  </Grid>
                  <Border Background="#183B82F6" BorderBrush="#403B82F6" BorderThickness="1" CornerRadius="6" Padding="10"
                          IsVisible="{Binding ShowPumpkinPlayitCallout}">
                    <TextBlock Text="{Binding PumpkinPlayitCalloutText}" FontSize="11" Foreground="#93C5FD" TextWrapping="Wrap"/>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Right Column: World & Gameplay Settings -->
          <Border Grid.Column="2" Classes="card" Padding="20" VerticalAlignment="Top">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <lucide:LucideIcon Kind="Globe" Size="18" Foreground="#10B981"/>
                <TextBlock Text="World &amp; Gameplay Settings" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="World Seed" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding WorldSeed, Mode=TwoWay}" Watermark="Leave empty for random seed"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="World Generation Type" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding LevelTypes}" SelectedItem="{Binding SelectedLevelType}" HorizontalAlignment="Stretch"/>
              </StackPanel>

              <Grid ColumnDefinitions="*, 12, *">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="Default Gamemode" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <ComboBox ItemsSource="{Binding Gamemodes}" SelectedItem="{Binding SelectedGamemode}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="World Difficulty" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <ComboBox ItemsSource="{Binding Difficulties}" SelectedItem="{Binding SelectedDifficulty}" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*, 12, *">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="Players Limit" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBox Text="{Binding MaxPlayers, Mode=TwoWay}" Watermark="20"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="Server Port" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBox Text="{Binding ServerPort, Mode=TwoWay}" Watermark="25565"/>
                </StackPanel>
              </Grid>

              <StackPanel Spacing="4">
                <TextBlock Text="Custom World Archive (.zip / .mcworld)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Grid ColumnDefinitions="*, 8, Auto">
                  <TextBox Grid.Column="0" Text="{Binding CustomWorldPath, Mode=TwoWay}" Watermark="Optional (.zip / .mcworld)"/>
                  <Button Grid.Column="2" Command="{Binding BrowseWorldCommand}" Content="Browse" Classes="secondary"/>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- Sticky Bottom EULA & Download Footer -->
    <Border Grid.Row="2" Padding="28,14"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*, Auto">
        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center" Margin="0,0,20,0">
          <CheckBox IsChecked="{Binding AcceptEula, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="I accept the Minecraft End User License Agreement (EULA)" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <Button Command="{Binding OpenEulaLinkCommand}" Classes="subtle" Padding="4,0" Content="View EULA" FontSize="12"/>
            </StackPanel>
          </CheckBox>

          <StackPanel Spacing="4" IsVisible="{Binding IsCreating}">
            <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="5" CornerRadius="3"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding CancelCommand}" Content="Cancel" Classes="secondary" Padding="16,8"/>
          <Button Command="{Binding CreateInstanceCommand}" Classes="primary" Padding="18,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="Download" Size="15"/>
              <TextBlock Text="Create and Download"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
