<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PocketMC.App.ViewModels"
             xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
             x:Class="PocketMC.App.Views.NewInstancePage"
             x:DataType="vm:NewInstanceViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto, *, Auto" Margin="28,20,28,24">
        <!-- HEADER: Matches Windows TitleBar & Import Modpack / Import Instance actions -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding CancelCommand}"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        MinWidth="88" Margin="0,0,14,0" Padding="12,6"
                        CornerRadius="6" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <lucide:LucideIcon Kind="ArrowLeft" Size="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Back" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Create a New Instance" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Right Header: Import Modpack & Import Instance Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsEnabled="{Binding !IsCreating}">
                <Button Command="{Binding ImportModpackCommand}"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6" Padding="12,6" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <lucide:LucideIcon Kind="Package" Size="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Import Modpack" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="#33FFB347" BorderBrush="#FFFFB347" BorderThickness="1" CornerRadius="4" Padding="4,0" VerticalAlignment="Center">
                            <TextBlock Text="BETA" FontSize="10" FontWeight="Bold" Foreground="#FFFFB347" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ImportInstanceCommand}"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        MinWidth="136" CornerRadius="6" Padding="12,6" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <lucide:LucideIcon Kind="Upload" Size="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Import Instance" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- MAIN 2-COLUMN CARDS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" IsEnabled="{Binding !IsCreating}">
            <Grid ColumnDefinitions="*, 20, *">
                <!-- LEFT COLUMN: Server Identity & Software -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        BoxShadow="0 8 24 0 #20000000"
                        Padding="24"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="16">
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                            <lucide:LucideIcon Kind="Server" Size="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Server Identity &amp; Software" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Server Name -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Server Name" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="My Cool Server" MaxLength="32" CornerRadius="6"/>
                            <ItemsControl ItemsSource="{Binding (DataValidationErrors.Errors)}" Foreground="#ef4444" FontSize="12"/>
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Description" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Text="{Binding Description, Mode=TwoWay}" Watermark="What this instance is for" CornerRadius="6"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,4"/>

                        <!-- Server Type / Engine -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Server Type" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ComboBox ItemsSource="{Binding EngineTypes}" SelectedItem="{Binding SelectedEngine, Mode=TwoWay}" HorizontalAlignment="Stretch" CornerRadius="6"/>
                        </StackPanel>

                        <!-- Minecraft Version -->
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Minecraft Version" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding ShowSnapshots, Mode=TwoWay}" VerticalAlignment="Center">
                                    <TextBlock Text="Show Snapshots" FontSize="12" Opacity="0.8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </CheckBox>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto">
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsLoadingVersions}" CornerRadius="6"/>
                                <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsLoadingVersions}" Width="20" Height="20" Margin="12,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,4" IsVisible="{Binding IsJavaEngine}"/>

                        <!-- Cross-play Addon (Geyser) -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsJavaEngine}">
                            <CheckBox IsChecked="{Binding EnableGeyser, Mode=TwoWay}">
                                <TextBlock Text="Enable Cross-play (Geyser + Floodgate)" FontWeight="SemiBold" FontSize="13"/>
                            </CheckBox>
                            <TextBlock Text="Allows Minecraft Bedrock players to join this Java server." FontSize="12" Opacity="0.8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="28,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- RIGHT COLUMN: World & Gameplay Settings -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        BoxShadow="0 8 24 0 #20000000"
                        Padding="24"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="16">
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                            <lucide:LucideIcon Kind="Globe" Size="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="World &amp; Gameplay Settings" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- World Seed -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="World Seed" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Text="{Binding WorldSeed, Mode=TwoWay}" Watermark="Leave empty for random seed" CornerRadius="6"/>
                        </StackPanel>

                        <!-- World Generation Type -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="World Generation Type" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ComboBox ItemsSource="{Binding LevelTypes}" SelectedItem="{Binding SelectedLevelType, Mode=TwoWay}" HorizontalAlignment="Stretch" CornerRadius="6"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,4"/>

                        <!-- Gamemode -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Default Gamemode" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ComboBox ItemsSource="{Binding Gamemodes}" SelectedItem="{Binding SelectedGamemode, Mode=TwoWay}" HorizontalAlignment="Stretch" CornerRadius="6"/>
                        </StackPanel>

                        <!-- World Difficulty -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="World Difficulty" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ComboBox ItemsSource="{Binding Difficulties}" SelectedItem="{Binding SelectedDifficulty, Mode=TwoWay}" HorizontalAlignment="Stretch" CornerRadius="6"/>
                        </StackPanel>

                        <!-- Max Players -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Players Limit" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Text="{Binding MaxPlayers, Mode=TwoWay}" CornerRadius="6"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,4"/>

                        <!-- Custom World Upload -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Custom World Upload (.zip / .mcworld)" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" Text="{Binding CustomWorldPath, Mode=OneWay}" Watermark="Optional (.zip / .mcworld)" IsReadOnly="True" CornerRadius="6" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Command="{Binding BrowseWorldCommand}" Content="Browse" CornerRadius="6" Padding="12,6"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- STICKY FOOTER ACTION BAR -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,16">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                    <!-- EULA Checkbox -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox IsChecked="{Binding AcceptEula, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="I accept the Minecraft End User License Agreement" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock FontSize="12" Opacity="0.8" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                PocketMC will write eula.txt automatically. Review Mojang's EULA before creating the instance.
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Download Progress Indicator -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsCreating}" Margin="0,8,28,0">
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="4" HorizontalAlignment="Stretch" CornerRadius="2"/>
                        <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding CancelCommand}" Content="Cancel" Padding="16,8" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            Cursor="Hand"/>
                    <Button Command="{Binding CreateInstanceCommand}" Padding="16,8" CornerRadius="6"
                            Background="{DynamicResource AccentPrimaryBrush}" Foreground="White"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="Download" Size="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Create and Download" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
