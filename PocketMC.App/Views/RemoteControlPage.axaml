<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PocketMC.App.ViewModels"
             xmlns:models="using:PocketMC.Core.Models"
             xmlns:lucide="using:Lucide.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="750"
             x:Class="PocketMC.App.Views.RemoteControlPage"
             x:DataType="vm:RemoteControlViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto, *">
        <!-- HEADER BAR -->
        <Grid Grid.Row="0" Margin="24,20,24,12" ColumnDefinitions="Auto, *">
            <Button Grid.Column="0" Command="{Binding NavigateBackCommand}"
                    Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="6" Cursor="Hand" Margin="0,0,12,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="ArrowLeft" Size="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Back to Dashboard" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Remote Control" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- SCROLLABLE CONTENT AREA -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch" Margin="24,0,24,32" Spacing="16">

                <!-- TAB SWITCH BUTTONS -->
                <Grid ColumnDefinitions="*, *" Margin="0,0,0,4">
                    <ToggleButton Grid.Column="0" Content="General Settings"
                                  IsChecked="{Binding IsGeneralTab, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  MinHeight="40" Margin="0,0,8,0" CornerRadius="6" FontWeight="SemiBold" Cursor="Hand"/>
                    <ToggleButton Grid.Column="1" Content="Users &amp; Permissions"
                                  IsChecked="{Binding IsUsersTab, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                  MinHeight="40" Margin="8,0,0,0" CornerRadius="6" FontWeight="SemiBold" Cursor="Hand"/>
                </Grid>

                <!-- TAB 1: GENERAL SETTINGS -->
                <StackPanel Spacing="16" IsVisible="{Binding IsGeneralTab}">

                    <!-- CARD 1: ENABLE REMOTE CONTROL -->
                    <Border Classes="card" Padding="20">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Enable Remote Control" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Starts a local web dashboard secured by paired device tokens."
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,24,0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}"/>
                            </Grid>

                            <Separator Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2"/>

                            <Grid ColumnDefinitions="140, *" Margin="0,2,0,4">
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="6">
                                    <TextBlock Text="Port" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="F0" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Access Mode" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding AccessModes}"
                                              SelectedItem="{Binding SelectedAccessModeOption, Mode=TwoWay}"
                                              HorizontalAlignment="Left" MinWidth="260">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RemoteControlViewModel+RemoteAccessModeOption">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Cloudflare Quick Tunnel creates a temporary public URL. Anyone with the URL can reach the login/pairing page. Keep pairing disabled unless you are actively pairing a device."
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="PlayIt HTTPS tunnels require PlayIt Premium. Stop Remote Link disables the dedicated PocketMC Remote Control tunnel."
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>

                            <!-- PUBLIC & LAN CARDS (WHEN ENABLED) -->
                            <StackPanel Spacing="10" Margin="0,14,0,0" IsVisible="{Binding IsEnabled}">
                                <!-- Public Tunnel Card -->
                                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="14,10" IsVisible="{Binding IsPublicUrlCardVisible}">
                                    <Grid RowDefinitions="Auto, Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                            <lucide:LucideIcon Grid.Column="0" Kind="Globe" Size="20" Foreground="#2ECC71" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding PublicUrlProviderName, StringFormat='{}{0} Public URL'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                                <Panel Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding PublicUrl}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasPublicUrl}"/>
                                                    <Border Height="14" Width="180" Background="{DynamicResource CardBorderBrush}" CornerRadius="3" HorizontalAlignment="Left" IsVisible="{Binding IsLoadingPublicUrl}"/>
                                                    <TextBlock Text="{Binding PublicUrlErrorText}" FontSize="13" Foreground="#F38BA8" TextWrapping="Wrap" IsVisible="{Binding HasPublicUrlError}"/>
                                                </Panel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasPublicUrl}">
                                                <Button Command="{Binding CopyPublicUrlCommand}" Content="Copy URL" Padding="10,5" CornerRadius="6" Cursor="Hand"/>
                                                <Button Command="{Binding TogglePublicQrCommand}" Content="QR Code" Padding="10,5" CornerRadius="6" Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                        <!-- QR Code Area -->
                                        <StackPanel Grid.Row="1" IsVisible="{Binding IsPublicQrVisible}" HorizontalAlignment="Center" Margin="0,12,0,4" Spacing="6">
                                            <Border Background="White" Padding="8" CornerRadius="6" HorizontalAlignment="Center">
                                                <Image Source="{Binding PublicQrImage}" Width="150" Height="150" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="Scan to access the remote dashboard" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Local Network (LAN) Card -->
                                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="14,10" IsVisible="{Binding HasLocalUrl}">
                                    <Grid RowDefinitions="Auto, Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                            <lucide:LucideIcon Grid.Column="0" Kind="Network" Size="20" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Local Network (LAN)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding LocalUrl}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Command="{Binding CopyLocalUrlCommand}" Content="Copy URL" Padding="10,5" CornerRadius="6" Cursor="Hand"/>
                                                <Button Command="{Binding ToggleLocalQrCommand}" Content="QR Code" Padding="10,5" CornerRadius="6" Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                        <!-- QR Code Area -->
                                        <StackPanel Grid.Row="1" IsVisible="{Binding IsLocalQrVisible}" HorizontalAlignment="Center" Margin="0,12,0,4" Spacing="6">
                                            <Border Background="White" Padding="8" CornerRadius="6" HorizontalAlignment="Center">
                                                <Image Source="{Binding LocalQrImage}" Width="150" Height="150" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="Scan to access the local dashboard" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Status text -->
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" IsVisible="{Binding HasStatusText}" Foreground="#A6E3A1"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: GLOBAL AUTHENTICATION -->
                    <Border Classes="card" Padding="20">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <lucide:LucideIcon Grid.Column="0" Kind="Key" Size="20" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Global Authentication" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Enable or disable password requirement for the dashboard." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding RequireAuthentication}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="When enabled, anyone accessing the remote dashboard must enter the password."
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="32,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: DISCORD NOTIFICATIONS -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <lucide:LucideIcon Grid.Column="0" Kind="MessageSquare" Size="20" Foreground="#5865F2" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Discord Notifications" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Link your Discord account to receive generated URLs via Direct Message." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding EnableDiscordNotifications}" IsEnabled="{Binding IsDiscordLinked}" VerticalAlignment="Center"/>
                            </Grid>
                            <Separator Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Status:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Linked" FontSize="12" Foreground="#A6E3A1" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding IsDiscordLinked}"/>
                                <TextBlock Text="Not Linked" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsVisible="{Binding IsDiscordNotLinked}"/>
                            </StackPanel>
                            <StackPanel Spacing="8" IsVisible="{Binding IsDiscordNotLinked}">
                                <TextBlock Text="To link your account, join our Discord server and use the /link command. You'll receive a connect button via DM."
                                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Button Command="{Binding JoinDiscordCommand}" Content="Join Discord Server" Padding="12,6" CornerRadius="6" HorizontalAlignment="Left" Cursor="Hand"/>
                            </StackPanel>
                            <TextBlock Text="Send an automatic Direct Message via your PocketMC Discord Bot when the remote control URL gets generated."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsDiscordLinked}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAB 2: USERS & PERMISSIONS -->
                <StackPanel Spacing="16" IsVisible="{Binding IsUsersTab}">
                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dashboard Users" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Manage who can access the remote dashboard and what permissions they have. Note: As the desktop user, you are the Owner and have full access."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding AddUserCommand}" Content="Add User" Padding="14,8" CornerRadius="6" Cursor="Hand" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Status Message Banner -->
                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" IsVisible="{Binding HasStatusText}">
                        <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="Medium" Foreground="#A6E3A1" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Admin Credentials Card -->
                    <Border Classes="card" Padding="20">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto, *">
                                <lucide:LucideIcon Grid.Column="0" Kind="ShieldCheck" Size="20" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Admin Credentials" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Manage the primary admin account used for dashboard login." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Separator Height="1" Background="{DynamicResource CardBorderBrush}"/>
                            <Grid ColumnDefinitions="140, *" RowDefinitions="Auto, Auto, Auto, Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Admin Username" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Username, Mode=TwoWay}" Watermark="Enter admin username" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Admin Password" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,12"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Password, Mode=TwoWay}" PasswordChar="*" Watermark="Enter admin password" Margin="0,0,0,12"/>

                                <Button Grid.Row="2" Grid.Column="1" Command="{Binding SaveCredentialsCommand}" Content="Save Admin Account" Padding="14,7" CornerRadius="6" HorizontalAlignment="Left" Cursor="Hand"/>

                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0" IsVisible="{Binding IsOwnerSetupVisible}">
                                    <lucide:LucideIcon Kind="ShieldAlert" Size="16" Foreground="#F38BA8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Missing credentials! Dashboard is vulnerable until you configure an admin account." Foreground="#F38BA8" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Sub-users list -->
                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RemoteControlUserViewModel">
                                <Border Classes="card" Padding="18" Margin="0,0,0,12">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <lucide:LucideIcon Grid.Column="0" Kind="User" Size="20" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding Username, Mode=TwoWay}" Watermark="Username" MaxWidth="280" HorizontalAlignment="Left"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                <Button Command="{Binding $parent[UserControl].((vm:RemoteControlViewModel)DataContext).SaveUserCommand}" CommandParameter="{Binding}" Content="Save" Padding="12,5" CornerRadius="6" Cursor="Hand"/>
                                                <Button Command="{Binding $parent[UserControl].((vm:RemoteControlViewModel)DataContext).RemoveUserCommand}" CommandParameter="{Binding}" Content="Delete" Padding="12,5" CornerRadius="6" Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="140, *" Margin="0,4,0,0">
                                            <TextBlock Grid.Column="0" Text="Password" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Password, Mode=TwoWay}" PasswordChar="*" Watermark="Enter new password to update" MaxWidth="280" HorizontalAlignment="Left"/>
                                        </Grid>

                                        <Separator Height="1" Background="{DynamicResource CardBorderBrush}"/>

                                        <Grid ColumnDefinitions="*, *">
                                            <StackPanel Grid.Column="0" Spacing="8">
                                                <CheckBox IsChecked="{Binding AllowRemoteConsoleCommands}" Content="Allow Console Commands" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <CheckBox IsChecked="{Binding AllowRemotePlayerActions}" Content="Allow Player Actions (Kick / Ban / Op)" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <CheckBox IsChecked="{Binding AllowRemoteServerSettings}" Content="Allow Server Settings Changes" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <CheckBox IsChecked="{Binding AllowRemoteServerAddons}" Content="Allow Plugin / Mod Management" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <CheckBox IsChecked="{Binding AllowRemoteFileManager}" Content="Allow File Manager Operations" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <CheckBox IsChecked="{Binding AllowRemoteServerBackups}" Content="Allow Backup Creation / Restore" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
